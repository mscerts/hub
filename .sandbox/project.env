# Literal sandbox configuration. Matching outer quotes are allowed.
PROJECT_ID=hub
NODE_VERSION=22
PNPM_VERSION=11.15.1

# Commands are optional. Empty commands are skipped by `run all`.
AUDIT_COMMAND="audit --audit-level=high"
LINT_COMMAND=
TYPECHECK_COMMAND=
BUILD_COMMAND=build

# Space-separated project-specific build-only environment assignments.
# Never put real credentials here.
BUILD_ENV="NEXT_TELEMETRY_DISABLED=1"

# Extra writable paths inside the container, space-separated.
# Keep this empty unless the framework requires one.
EXTRA_TMPFS=

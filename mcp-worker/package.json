{
  "name": "@msfthub/mcp-worker",
  "version": "0.1.0",
  "description": "Cloudflare Worker MCP server for msfthub",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "bundle": "tsx scripts/bundle.ts",
    "check": "pnpm test && tsc --noEmit",
    "test": "pnpm bundle && tsx --test tests/*.test.ts",
    "build": "wrangler deploy --dry-run",
    "deploy": "pnpm bundle && wrangler deploy",
    "dev": "pnpm bundle && wrangler dev"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "gray-matter": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.3"
  }
}

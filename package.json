{
  "name": "msfthub",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build --force && node scripts/verify-public-routes.mjs && node scripts/verify-route-manifest.mjs && pnpm search:index && pnpm search:verify",
    "preview": "astro preview",
    "search:index": "pagefind --site dist",
    "search:verify": "node scripts/verify-pagefind.mjs",
    "format": "prettier --write package.json astro.config.mjs \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \".github/workflows/*.yml\" .github/dependabot.yml src/content.config.ts \"src/utils/*.ts\" \"src/components/docs/preline/{LinkCard,LinkButton}.astro\" \"src/components/ui/icons/*.{astro,ts}\"",
    "format:check": "prettier --check package.json astro.config.mjs \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \".github/workflows/*.yml\" .github/dependabot.yml src/content.config.ts \"src/utils/*.ts\" \"src/components/docs/preline/{LinkCard,LinkButton}.astro\" \"src/components/ui/icons/*.{astro,ts}\"",
    "typecheck": "astro check",
    "lint": "bash -n scripts/*.sh scripts/pnpm-sandbox && pnpm typecheck",
    "test:scripts": "node --test tests/scripts/*.test.mjs",
    "test:mcp": "pnpm --dir mcp-worker test",
    "test": "pnpm test:scripts && pnpm test:mcp",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "0.9.11",
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.4.1",
    "astro-icon": "^1.1.5",
    "clipboard": "^2.0.11",
    "clsx": "^2.1.1",
    "parse5": "8.0.1",
    "preline": "5.0.0",
    "remark-directive": "^4.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.5",
    "sharp-ico": "^0.1.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@iconify-json/arcticons": "^1.2.58",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/streamline": "^1.2.5",
    "@tailwindcss/forms": "^0.5.11",
    "pagefind": "1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}

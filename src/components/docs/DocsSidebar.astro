---
import type { DocsSidebarBadge, DocsSidebarItem } from "@data/docs-sidebar";

interface Props {
  items: DocsSidebarItem[];
  currentPath: string;
  idPrefix?: string;
  path?: string;
}

const { items, currentPath, idPrefix = "docs", path = "0" } = Astro.props;

function containsCurrent(item: DocsSidebarItem): boolean {
  return item.href === currentPath || Boolean(item.children?.some(containsCurrent));
}

function badgeClass(badge: DocsSidebarBadge) {
  const isVoucher = badge.text.includes("%");
  const isHighDiscount = isVoucher && !badge.text.includes("50%");

  if (badge.variant === "tip") {
    return isVoucher
      ? isHighDiscount
        ? "border-[#d946ef]/60 bg-[#d946ef]/15 text-[#f0abfc]"
        : "border-[#3b82f6]/60 bg-[#3b82f6]/15 text-[#93c5fd]"
      : "border-[#d946ef]/60 bg-[#d946ef]/15 text-[#f0abfc]";
  }

  if (badge.text === "GA" || badge.variant === "success") {
    return "border-[#22c55e]/60 bg-[#22c55e]/15 text-[#86efac]";
  }

  if (badge.variant === "caution") {
    return "border-[#f59e0b]/60 bg-[#f59e0b]/15 text-[#fcd34d]";
  }

  if (badge.variant === "danger") {
    return "border-[#ec4899]/60 bg-[#ec4899]/15 text-[#f9a8d4]";
  }

  return isVoucher && !isHighDiscount
    ? "border-[#3b82f6]/60 bg-[#3b82f6]/15 text-[#93c5fd]"
    : isVoucher
      ? "border-[#d946ef]/60 bg-[#d946ef]/15 text-[#f0abfc]"
      : "border-[#7f8da0]/60 bg-[#2d3949] text-[#bbc3cd]";
}

function groupId(item: DocsSidebarItem, index: number) {
  const slug = item.label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
  return `${idPrefix}-${path}-${index}-${slug}`;
}
---

<ul class="m-0 grid list-none gap-1 p-0" data-docs-sidebar>
  {items.map((item, index) => {
    const hasChildren = Boolean(item.children?.length);
    const isCurrent = item.href === currentPath;
    const isOpen = hasChildren && (item.collapsed === false || containsCurrent(item));
    const id = groupId(item, index);

    return (
      <li class="m-0" data-docs-nav-group={hasChildren ? "true" : undefined}>
        {hasChildren ? (
          <div class:list={["hs-accordion", isOpen && "active"]} id={id}>
            <button
              type="button"
              id={`${id}-toggle`}
              class:list={[
                "hs-accordion-toggle group flex w-full items-center gap-x-2 rounded-md px-3 py-2 text-left text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white",
                containsCurrent(item) && "text-gray-900 dark:text-white",
              ]}
              aria-expanded={isOpen ? "true" : "false"}
              aria-controls={`${id}-content`}
            >
              <span class="min-w-0 flex-1 break-words">{item.label}</span>
              {item.badge && <span class:list={["rounded-full border px-1.5 py-0.5 text-[0.6rem] font-bold leading-none tracking-wide", badgeClass(item.badge)]}>{item.badge.text}</span>}
              <svg class="size-3.5 shrink-0 transition-transform hs-accordion-active:rotate-180" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg>
            </button>
            <div id={`${id}-content`} class:list={["hs-accordion-content w-full overflow-hidden transition-[height] duration-300", !isOpen && "hidden"]} role="region" aria-labelledby={`${id}-toggle`}>
              <div class="ms-3 mt-1 border-s border-gray-200 ps-2 dark:border-gray-700">
                <Astro.self items={item.children ?? []} currentPath={currentPath} idPrefix={idPrefix} path={`${path}-${index}`} />
              </div>
            </div>
          </div>
        ) : item.href ? (
          <a
            href={item.href}
            data-docs-nav-item
            data-docs-nav-label={item.label}
            aria-current={isCurrent ? "page" : undefined}
            class:list={[
              "flex min-h-9 items-center justify-between gap-x-2 rounded-md px-3 py-2 text-sm font-medium text-gray-600 no-underline transition hover:bg-gray-100 hover:text-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white",
              isCurrent && "border border-gray-400 bg-gray-100 text-gray-900 dark:border-gray-600 dark:bg-[#2a2a2a] dark:text-white",
            ]}
          >
            <span class="min-w-0 break-words">{item.label}</span>
            {item.badge && <span class:list={["shrink-0 rounded-full border px-1.5 py-0.5 text-[0.6rem] font-bold leading-none tracking-wide", badgeClass(item.badge)]}>{item.badge.text}</span>}
          </a>
        ) : (
          <span class="flex min-h-9 items-center rounded-md px-3 py-2 text-sm font-medium text-gray-400 dark:text-gray-500" data-docs-nav-item data-docs-nav-label={item.label}>{item.label}</span>
        )}
      </li>
    );
  })}
</ul>

---
import DocsShell from "../DocsShell.astro";
import { docsSidebar } from "@data/docs-sidebar";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  headings: Heading[];
  sectionLabel: string;
}

const { title, description, headings, sectionLabel } = Astro.props;
---

<DocsShell
  {sectionLabel}
  sidebarItems={docsSidebar}
  {title}
  {description}
  {headings}
>
  <slot />
</DocsShell>

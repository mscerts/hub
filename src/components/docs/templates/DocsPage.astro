---
import DocsShell from "../DocsShell.astro";
import { docsSidebar } from "@data/docs-sidebar";
import { editPageUrl } from "@utils/edit-page.mjs";
import type { DocsHero } from "@utils/docs";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  headings: Heading[];
  sectionLabel: string;
  sourcePath?: string;
  editUrl?: string;
  hero?: DocsHero;
  tableOfContents?: boolean;
  pagination?: boolean;
}

const {
  title,
  description,
  headings,
  sectionLabel,
  sourcePath,
  hero,
  tableOfContents,
  pagination,
  editUrl,
} = Astro.props;
---

<DocsShell
  {sectionLabel}
  sidebarItems={docsSidebar}
  {title}
  {description}
  {headings}
  editUrl={editUrl ?? editPageUrl(sourcePath)}
  {hero}
  {tableOfContents}
  {pagination}
>
  <slot />
</DocsShell>

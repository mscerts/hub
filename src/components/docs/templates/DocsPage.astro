---
import DocsShell from "../DocsShell.astro";
import { docsSidebar } from "@data/docs-sidebar";
import { editPageUrl } from "@utils/edit-page.mjs";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  headings: Heading[];
  sectionLabel: string;
  sourcePath?: string;
}

const { title, description, headings, sectionLabel, sourcePath } = Astro.props;
---

<DocsShell
  {sectionLabel}
  sidebarItems={docsSidebar}
  {title}
  {description}
  {headings}
  editUrl={editPageUrl(sourcePath)}
>
  <slot />
</DocsShell>

---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"div"> {}
const { class: className, ...attrs } = Astro.props;
---
<div data-docs-tabs-list class:list={["flex overflow-x-auto border-b border-gray-200 dark:border-gray-700", className]} role="tablist" {...attrs}><slot /></div>

---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "secondary" | "ghost" | "destructive" | "secondary-destructive" | "outline" | "minimal";
type Size = "xs" | "sm" | "base" | "lg" | "md";
type Shape = "base" | "square" | "circle";
interface Props extends HTMLAttributes<"a"> { href: string; variant?: Variant; size?: Size; shape?: Shape; icon?: boolean; }
const { href, variant = "primary", size = "md", shape = "base", icon = false, class: className, ...attrs } = Astro.props;
const resolvedVariant = variant === "minimal" ? "ghost" : variant;
const resolvedSize = size === "md" ? "base" : size;
const variants = {
  primary: "bg-blue-600 text-white hover:bg-blue-700 focus:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600",
  secondary: "border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700",
  ghost: "text-gray-600 hover:bg-gray-100 hover:text-gray-800 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white",
  destructive: "bg-red-600 text-white hover:bg-red-700 dark:bg-red-500 dark:hover:bg-red-600",
  "secondary-destructive": "border border-gray-200 bg-white text-red-600 hover:bg-red-50 dark:border-gray-700 dark:bg-gray-800 dark:text-red-400 dark:hover:bg-red-950/30",
  outline: "border border-gray-200 text-gray-800 hover:bg-gray-50 dark:border-gray-700 dark:text-white dark:hover:bg-gray-800",
} as const;
const sizes = { xs: "h-7 gap-1 px-2 text-xs", sm: "h-8 gap-1 px-3 text-xs", base: "h-9 gap-1.5 px-4 text-sm", lg: "h-10 gap-2 px-5 text-sm" } as const;
const compact = { xs: "size-7", sm: "size-8", base: "size-9", lg: "size-10" } as const;
const classes = shape === "base" ? sizes[resolvedSize] : `${compact[resolvedSize]} p-0 ${shape === "circle" ? "rounded-full" : ""}`;
---
<a href={href} data-docs-link-button class:list={["group not-prose inline-flex shrink-0 items-center justify-center gap-1.5 rounded-lg font-medium whitespace-nowrap no-underline transition focus-visible:outline-2 focus-visible:outline-offset-2", variants[resolvedVariant], classes, className]} {...attrs}>
  <slot />
  {icon && <Icon name="ph:caret-right" class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />}
</a>

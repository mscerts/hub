---
import type { HTMLAttributes } from "astro/types";
import { renderTabPanels } from "@utils/render-tabs.mjs";
interface Props extends HTMLAttributes<"div"> {
  syncKey?: string;
}
const { syncKey, class: className, ...attrs } = Astro.props;
const state = Astro.locals as { docsTabsCount?: number };
const ordinal = (state.docsTabsCount ?? 0) + 1;
state.docsTabsCount = ordinal;
const { html, tabs } = renderTabPanels(
  await Astro.slots.render("default"),
  `docs-tabs-${ordinal}`,
);
---

<div
  data-docs-tabs
  data-docs-sync-key={syncKey}
  class:list={["not-prose", className]}
  {...attrs}
>
  <div data-docs-tabs-scroll class="relative">
    <div
      data-docs-tabs-list
      data-subtle-scrollbar
      class="--prevent-on-load-init subtle-scrollbar border-border flex overflow-x-auto overflow-y-hidden overscroll-x-contain border-b"
      role="tablist"
    >
      {tabs.map(({ label, id }, index) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab`}
          data-docs-tabs-trigger
          aria-controls={id}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          class="-mb-px shrink-0 border-b-2 border-transparent px-5 py-3.5 text-base font-medium text-muted-foreground transition hover:border-border-strong hover:text-foreground aria-selected:border-primary aria-selected:text-primary"
        >
          {label}
        </button>
      ))}
    </div>
    <div
      data-docs-tabs-arrow="left"
      class="from-background absolute inset-y-0 left-0 z-10 flex w-12 items-center bg-gradient-to-r to-transparent pl-1"
    >
      <button
        type="button"
        aria-label="Scroll tabs left"
        class="border-border bg-card text-muted-foreground hover:text-foreground focus-visible:outline-blue-600 grid size-7 place-items-center rounded-full border shadow-sm transition focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="m10 12-4-4 4-4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </div>
    <div
      data-docs-tabs-arrow="right"
      class="from-background absolute inset-y-0 right-0 z-10 flex w-12 items-center justify-end bg-gradient-to-l to-transparent pr-1"
    >
      <button
        type="button"
        aria-label="Scroll tabs right"
        class="border-border bg-card text-muted-foreground hover:text-foreground focus-visible:outline-blue-600 grid size-7 place-items-center rounded-full border shadow-sm transition focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="m6 4 4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>
  <div data-docs-tabs-content-wrapper class="mt-3" set:html={html} />
</div>
<style>
  [data-docs-tabs-arrow] {
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease;
  }
  [data-docs-tabs-scroll][data-can-scroll="both"]:is(:hover, :focus-within)
    [data-docs-tabs-arrow],
  [data-docs-tabs-scroll][data-can-scroll="left"]:is(:hover, :focus-within)
    [data-docs-tabs-arrow="left"],
  [data-docs-tabs-scroll][data-can-scroll="right"]:is(:hover, :focus-within)
    [data-docs-tabs-arrow="right"] {
    opacity: 1;
    pointer-events: auto;
  }
  [data-docs-tabs-scroll][data-can-scroll="none"] [data-docs-tabs-arrow],
  [data-docs-tabs-scroll][data-can-scroll="left"]
    [data-docs-tabs-arrow="right"],
  [data-docs-tabs-scroll][data-can-scroll="right"]
    [data-docs-tabs-arrow="left"] {
    display: none;
  }
  @media (hover: none) {
    [data-docs-tabs-scroll][data-can-scroll="both"] [data-docs-tabs-arrow],
    [data-docs-tabs-scroll][data-can-scroll="left"]
      [data-docs-tabs-arrow="left"],
    [data-docs-tabs-scroll][data-can-scroll="right"]
      [data-docs-tabs-arrow="right"] {
      opacity: 1;
      pointer-events: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-docs-tabs-arrow] {
      transition: none;
    }
  }
</style>
<noscript>
  <style is:inline>
    @layer base {
      [data-docs-tabs] [data-docs-tabs-list] {
        display: none !important;
      }
      [data-docs-tabs-content-wrapper] > [data-docs-tabs-content][hidden] {
        display: block !important;
      }
      [data-docs-tabs-content] > [data-docs-tab-fallback] {
        display: block !important;
        margin-block: 1rem;
        font-weight: 600;
      }
    }
  </style>
</noscript>
<script>
  const slugify = (value: string) =>
    value
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");

  const scrollBehavior = (): ScrollBehavior =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ? "auto"
      : "smooth";

  function scrollTabIntoView(list: HTMLElement, trigger: HTMLElement) {
    const padding = 8;
    const listRect = list.getBoundingClientRect();
    const rect = trigger.getBoundingClientRect();
    if (rect.left < listRect.left + padding) {
      list.scrollBy({
        left: rect.left - listRect.left - padding,
        behavior: scrollBehavior(),
      });
    } else if (rect.right > listRect.right - padding) {
      list.scrollBy({
        left: rect.right - listRect.right + padding,
        behavior: scrollBehavior(),
      });
    }
  }

  function initTabScrollControls(list: HTMLElement) {
    const wrap = list.parentElement;
    if (!wrap?.hasAttribute("data-docs-tabs-scroll")) return;
    const left = wrap.querySelector<HTMLButtonElement>(
      '[data-docs-tabs-arrow="left"] button',
    );
    const right = wrap.querySelector<HTMLButtonElement>(
      '[data-docs-tabs-arrow="right"] button',
    );
    if (!left || !right) return;

    const update = () => {
      const max = list.scrollWidth - list.clientWidth;
      if (max <= 1) {
        wrap.dataset.canScroll = "none";
        return;
      }
      const atStart = list.scrollLeft <= 1;
      const atEnd = list.scrollLeft >= max - 1;
      wrap.dataset.canScroll = atStart ? "right" : atEnd ? "left" : "both";
    };
    const scrollByPage = (direction: number) => {
      list.scrollBy({
        left: direction * Math.max(120, list.clientWidth * 0.8),
        behavior: scrollBehavior(),
      });
    };

    left.addEventListener("click", () => scrollByPage(-1));
    right.addEventListener("click", () => scrollByPage(1));
    list.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    new ResizeObserver(update).observe(list);
    void document.fonts.ready.then(update);
    update();
  }

  function initDocsTabs() {
    document
      .querySelectorAll<HTMLElement>("[data-docs-tabs]")
      .forEach((root, rootIndex) => {
        if (root.dataset.docsTabsReady) return;
        const content = root.querySelector<HTMLElement>(
          ":scope > [data-docs-tabs-content-wrapper]",
        );
        const panels = content
          ? Array.from(
              content.querySelectorAll<HTMLElement>(
                ":scope > [data-docs-tabs-content]",
              ),
            )
          : [];
        const list = root.querySelector<HTMLElement>(
          ":scope > [data-docs-tabs-scroll] > [data-docs-tabs-list]",
        );
        if (!list || panels.length === 0) return;
        initTabScrollControls(list);
        const labels = panels.map((panel) => panel.dataset.docsTabLabel ?? "");
        const group =
          root.dataset.docsSyncKey || labels.join("-") || `group-${rootIndex}`;
        const groupSlug = `docs-tabs-${slugify(group)}`;
        root.dataset.docsTabsGroup = groupSlug;
        const tabHash = (label: string, index: number) =>
          `${groupSlug}-${index}-${slugify(label)}`;
        const updateUrl = (hash: string) => {
          const url = new URL(window.location.href);
          url.hash = hash;
          history.replaceState(null, "", url);
        };
        const activate = (active: number) => {
          panels.forEach((panel, index) => {
            const trigger = list.children[index] as HTMLElement;
            const selected = index === active;
            trigger.setAttribute("aria-selected", String(selected));
            trigger.tabIndex = selected ? 0 : -1;
            panel.hidden = !selected;
            if (selected) scrollTabIntoView(list, trigger);
          });
          const key = root.dataset.docsSyncKey;
          if (key) {
            try {
              localStorage.setItem(`docs-tabs__${key}`, String(active));
            } catch {
              /* Tabs remain usable when storage is blocked. */
            }
          }
        };
        const triggers = Array.from(
          list.querySelectorAll<HTMLElement>(
            "[role='tab'], [data-docs-tabs-trigger]",
          ),
        );
        panels.forEach((panel, index) => {
          const trigger = triggers[index];
          if (!trigger) return;
          const label =
            labels[index] || trigger.textContent?.trim() || `Tab ${index + 1}`;
          const hash = trigger.dataset.docsTabHash || tabHash(label, index);
          trigger.dataset.docsTabHash = hash;
          panel.dataset.docsTabHash = hash;
          if (!panel.id)
            panel.id = `${groupSlug}-${rootIndex}-panel-${index}-${slugify(label)}`;
          if (!trigger.id)
            trigger.id = `${groupSlug}-${rootIndex}-tab-${index}-${slugify(label)}`;
          trigger.setAttribute("aria-controls", panel.id);
          panel.setAttribute("role", "tabpanel");
          panel.setAttribute(
            "aria-labelledby",
            trigger.id || `docs-tab-${index}`,
          );
          trigger.addEventListener("click", () => {
            activate(index);
            updateUrl(hash);
          });
          trigger.addEventListener("keydown", (event) => {
            if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key))
              return;
            event.preventDefault();
            const delta =
              event.key === "ArrowLeft"
                ? -1
                : event.key === "ArrowRight"
                  ? 1
                  : 0;
            const next =
              event.key === "Home"
                ? 0
                : event.key === "End"
                  ? triggers.length - 1
                  : (index + delta + triggers.length) % triggers.length;
            triggers[next]?.focus();
            activate(next);
            updateUrl(triggers[next]?.dataset.docsTabHash || hash);
          });
        });
        const hashIndex = triggers.findIndex(
          (trigger) =>
            trigger.dataset.docsTabHash === window.location.hash.slice(1),
        );
        let stored = NaN;
        try {
          if (root.dataset.docsSyncKey) {
            const saved = localStorage.getItem(
              `docs-tabs__${root.dataset.docsSyncKey}`,
            );
            if (saved !== null) stored = Number(saved);
          }
        } catch {
          /* Use the first tab when storage is blocked. */
        }
        activate(
          hashIndex >= 0
            ? hashIndex
            : Number.isInteger(stored) && stored >= 0 && stored < panels.length
              ? stored
              : 0,
        );
        root.dataset.docsTabsReady = "true";
      });
  }

  function activateTabFromHash() {
    const hash = window.location.hash.slice(1);
    if (!hash) return;
    document
      .querySelectorAll<HTMLElement>("[data-docs-tabs]")
      .forEach((root) => {
        const triggers = Array.from(
          root.querySelectorAll<HTMLElement>(
            ":scope > [data-docs-tabs-scroll] > [data-docs-tabs-list] > [role='tab']",
          ),
        );
        const index = triggers.findIndex(
          (trigger) => trigger.dataset.docsTabHash === hash,
        );
        if (index >= 0) triggers[index]?.click();
      });
  }

  initDocsTabs();
  window.addEventListener("hashchange", activateTabFromHash);
</script>

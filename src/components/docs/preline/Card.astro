---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"article"> { title: string; icon?: string; }
const { title, icon, class: className, ...attrs } = Astro.props;
---
<article class:list={["not-prose my-5 rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-700 dark:bg-gray-800", className]} {...attrs}>
  <div class="flex items-center gap-3">
    {icon && <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200"><Icon name={icon} class="size-5" aria-hidden="true" /></span>}
    <h3 class="m-0 text-base font-semibold leading-snug text-gray-800 dark:text-white">{title}</h3>
  </div>
  <div class:list={["text-sm leading-relaxed text-gray-600 dark:text-gray-300", icon ? "mt-4" : "mt-2", "[&_p:first-child]:mt-0 [&_p:last-child]:mb-0"]}><slot /></div>
</article>

---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"button"> {
  value: string;
}
const { value, class: className, ...attrs } = Astro.props;
const target = `docs-manual-${value.replace(/[^a-z0-9]+/gi, "-")}`;
---

<button
  type="button"
  role="tab"
  data-docs-tabs-trigger
  data-hs-tab={`#${target}`}
  aria-controls={target}
  class:list={[
    "text-muted-foreground hover:border-border-strong hover:text-foreground -mb-px shrink-0 border-b-2 border-transparent px-5 py-3.5 text-base font-medium transition",
    className,
  ]}
  {...attrs}><slot /></button
>

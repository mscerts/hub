---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"button"> { value: string; }
const { value, class: className, ...attrs } = Astro.props;
const target = `docs-manual-${value.replace(/[^a-z0-9]+/gi, "-")}`;
---
<button type="button" role="tab" data-docs-tabs-trigger data-hs-tab={`#${target}`} aria-controls={target} class:list={["-mb-px shrink-0 border-b-2 border-transparent px-4 py-3 text-sm font-medium text-gray-500 transition hover:border-gray-300 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200", className]} {...attrs}><slot /></button>

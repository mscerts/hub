---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";
import { linkRel } from "../../../utils/link-rel";
import { iconHostname, linkSourceIcon } from "../../../utils/link-source-icon";
import { sidebarIconForHref } from "@data/docs-sidebar";
import resourceFavicons from "@data/resource-favicons.json";
interface Props extends HTMLAttributes<"a"> {
  title: string;
  description?: string;
  href: string;
  /** "review" marks a pick the course builder wants the maintainer to look at (orange); only generated review copies use it. */
  tone?: "review";
}
const {
  title,
  description,
  href,
  tone,
  target,
  rel,
  class: className,
  ...attrs
} = Astro.props;
const site = Astro.site ?? Astro.url;
const destination = new URL(href, site);
const isExternal =
  ["http:", "https:"].includes(destination.protocol) &&
  destination.origin !== site.origin;
const resolvedTarget = target ?? (isExternal ? "_blank" : undefined);
const resolvedRel = linkRel(resolvedTarget, rel);
const preferVectorIcon =
  destination.hostname === "learn.microsoft.com" ||
  destination.hostname.endsWith(".learn.microsoft.com") ||
  destination.hostname === "esi.microsoft.com" ||
  destination.hostname === "github.com" ||
  destination.hostname === "www.github.com";
const favicon =
  isExternal && !preferVectorIcon
    ? (resourceFavicons as Record<string, { path: string }>)[
        iconHostname(destination)
      ]?.path
    : undefined;
const cardIcon = isExternal
  ? linkSourceIcon(href)
  : (sidebarIconForHref(href) ?? linkSourceIcon(href));
---

<a
  href={href}
  target={resolvedTarget}
  rel={resolvedRel}
  class:list={[
    "docs-link-card group not-prose hover:shadow-default flex items-center justify-between gap-3 sm:gap-4 rounded-xl border p-4 sm:p-5 text-inherit no-underline shadow-sm transition hover:-translate-y-0.5",
    tone === "review"
      ? "docs-link-card--review border-[#f97316] bg-[#fff7ed] dark:border-[#fb923c] dark:bg-[#431407]/60"
      : "border-border bg-card hover:border-border-strong",
    className,
  ]}
  {...attrs}
>
  <span class="flex min-w-0 flex-1 items-start gap-2 sm:gap-3">
    <span
      class="border-border bg-muted text-card-foreground grid size-9 shrink-0 place-items-center rounded-lg border"
      aria-hidden="true"
    >
      {favicon ? (
        <img
          src={favicon}
          alt=""
          width="20"
          height="20"
          loading="lazy"
          decoding="async"
          class="size-5 shrink-0 object-contain grayscale dark:invert"
        />
      ) : (
        <Icon name={cardIcon} class="size-4.5" />
      )}
    </span>
    <span class="min-w-0">
      <span class="text-card-foreground group-hover:text-primary block text-base leading-snug font-semibold transition-colors">
        {title}
      </span>
      {description && (
        <span
          class:list={[
            "mt-1 block text-sm leading-normal",
            tone === "review"
              ? "text-[#9a3412] dark:text-[#fed7aa]"
              : "text-muted-foreground",
          ]}
        >
          {description}
        </span>
      )}
    </span>
  </span>
  <Icon
    name={isExternal ? "ph:arrow-up-right" : "ph:caret-right"}
    class="text-muted-foreground group-hover:text-primary size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
    aria-hidden="true"
  />
</a>

<style>
  :global(:not(.grid)) > .docs-link-card + .docs-link-card {
    margin-block-start: 1rem;
  }

  .docs-link-card,
  .docs-link-card :global(*) {
    text-decoration: none !important;
  }
</style>

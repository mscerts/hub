---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";
import { linkRel } from "../../../utils/link-rel";
import { linkSourceIcon } from "../../../utils/link-source-icon";
interface Props extends HTMLAttributes<"a"> {
  title: string;
  description?: string;
  href: string;
}
const {
  title,
  description,
  href,
  target,
  rel,
  class: className,
  ...attrs
} = Astro.props;
const site = Astro.site ?? Astro.url;
const destination = new URL(href, site);
const isExternal =
  ["http:", "https:"].includes(destination.protocol) &&
  destination.origin !== site.origin;
const resolvedTarget = target ?? (isExternal ? "_blank" : undefined);
const resolvedRel = linkRel(resolvedTarget, rel);
---

<a
  href={href}
  target={resolvedTarget}
  rel={resolvedRel}
  class:list={[
    "docs-link-card group not-prose border-border bg-card hover:border-border-strong hover:shadow-default flex items-center justify-between gap-4 rounded-xl border p-5 text-inherit no-underline shadow-sm transition hover:-translate-y-0.5",
    className,
  ]}
  {...attrs}
>
  <span class="flex min-w-0 flex-1 items-start gap-3">
    <span
      class="border-border bg-muted text-card-foreground grid size-9 shrink-0 place-items-center rounded-lg border"
      aria-hidden="true"
    >
      <Icon name={linkSourceIcon(href)} class="size-4.5" />
    </span>
    <span class="min-w-0">
      <span class="text-card-foreground group-hover:text-primary block text-base leading-snug font-semibold transition-colors">
        {title}
      </span>
      {description && (
        <span class="text-muted-foreground mt-1 block text-sm leading-normal">
          {description}
        </span>
      )}
    </span>
  </span>
  <Icon
    name={isExternal ? "ph:arrow-up-right" : "ph:caret-right"}
    class="text-muted-foreground group-hover:text-primary size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
    aria-hidden="true"
  />
</a>

<style>
  :global(:not(.grid)) > .docs-link-card + .docs-link-card {
    margin-block-start: 1rem;
  }

  .docs-link-card,
  .docs-link-card :global(*) {
    text-decoration: none !important;
  }
</style>

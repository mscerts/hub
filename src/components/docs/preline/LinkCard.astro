---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"a"> { title: string; description?: string; href: string; }
const { title, description, href, class: className, ...attrs } = Astro.props;
const isExternal = /^(?:https?:)?\/\//i.test(href);
---
<a href={href} class:list={["docs-link-card group not-prose flex items-center justify-between gap-4 rounded-xl border border-border bg-card p-5 text-inherit no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-border-strong hover:shadow-default", className]} {...attrs}>
  <span class="min-w-0"><span class="block text-base font-semibold leading-snug text-card-foreground transition-colors group-hover:text-primary">{title}</span>{description && <span class="mt-1 block text-sm leading-normal text-muted-foreground">{description}</span>}</span>
  <Icon name={isExternal ? "ph:arrow-up-right" : "ph:caret-right"} class="size-4 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-primary" aria-hidden="true" />
</a>

<style>
  .docs-link-card,
  .docs-link-card :global(*) {
    text-decoration: none !important;
  }
</style>

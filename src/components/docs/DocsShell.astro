---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  sectionLabel: string;
  sidebarItems: import("@data/docs-sidebar").DocsSidebarItem[];
  title: string;
  description: string;
  headings: Heading[];
}

import DocsSidebar from "./DocsSidebar.astro";
import DocsPageActions from "./DocsPageActions.astro";
import DocsTableOfContents from "./DocsTableOfContents.astro";
import DocsCreditCard from "./DocsCreditCard.astro";

const { sectionLabel, sidebarItems, title, description, headings } = Astro.props;
const currentPath = Astro.url.pathname;
const visibleHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
const breadcrumbLabel = sectionLabel.replace(/^Certification Program /, "");
---

<div data-docs class="w-full bg-neutral-50 dark:bg-[#222222]">
  <div class="flex min-h-[calc(100vh-4rem)] w-full">
    <aside
      class="docs-sidebar hidden min-h-[calc(100vh-4rem)] w-72 shrink-0 border-r border-neutral-200 bg-neutral-100/70 lg:block dark:border-[#383838] dark:bg-[#1d1d1d]"
      aria-label={`${sectionLabel} navigation`}
    >
      <div
        class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto px-6 py-8"
      >
        <nav data-docs-nav aria-label="Documentation navigation">
            <DocsSidebar items={sidebarItems} currentPath={currentPath} idPrefix="desktop" />
          </nav>
      </div>
    </aside>

    <main id="main-content" class="min-w-0 flex-1">
        <div class="mx-auto max-w-4xl px-5 py-8 sm:px-8 sm:py-12 lg:px-10">
        <nav
            class="text-xs font-medium text-neutral-500 dark:text-[#9aa7b5]"
          aria-label="Breadcrumb"
        >
          <a
            href="/wiki/"
            class="hover:text-[#7890a6] dark:hover:text-[#b0c0cf]">Wiki</a
          >
          <span class="px-2" aria-hidden="true">/</span>
          <span>{breadcrumbLabel}</span>
        </nav>

        <header
          class="mt-6 border-b border-neutral-200 pb-8 dark:border-[#383838]"
        >
          <h1
            class="text-4xl font-bold tracking-tight text-neutral-950 sm:text-5xl dark:text-[#f4f4f4]"
          >
            {title}
          </h1>
          <DocsPageActions title={title} />
          <p
            class="mt-4 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-[#b8b8b8]"
          >
            {description}
          </p>
        </header>

        <details
          class="docs-mobile-nav mt-6 rounded-xl border border-neutral-200 bg-neutral-100 p-4 lg:hidden dark:border-[#383838] dark:bg-[#1d1d1d]"
        >
          <summary
            class="cursor-pointer text-sm font-semibold text-neutral-800 dark:text-[#f4f4f4]"
          >
            Browse documentation
          </summary>
           <nav
             class="mt-3 grid gap-1"
             aria-label="Documentation mobile navigation"
           >
              <DocsSidebar items={sidebarItems} currentPath={currentPath} idPrefix="mobile" />
           </nav>
         </details>

        {
          visibleHeadings.length > 0 && (
            <details class="docs-mobile-toc mt-4 rounded-xl border border-neutral-200 bg-neutral-100 p-4 xl:hidden dark:border-[#383838] dark:bg-[#1d1d1d]">
              <summary class="cursor-pointer text-sm font-semibold text-neutral-800 dark:text-[#f4f4f4]">
                On this page
              </summary>
              <div class="mt-3">
                <DocsTableOfContents headings={visibleHeadings} variant="mobile" />
              </div>
            </details>
          )
        }

        <article
          class="docs-content mt-10 max-w-none"
          data-pagefind-body
        >
          <slot />
        </article>
      </div>
    </main>

    <aside
      class="docs-toc hidden min-h-[calc(100vh-4rem)] w-64 shrink-0 border-l border-neutral-200 xl:block dark:border-[#383838]"
      aria-label="On this page"
    >
      <div
        class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto px-6 py-12"
      >
        <DocsTableOfContents headings={visibleHeadings} />
        <div class="mt-8">
          <DocsCreditCard />
        </div>
      </div>
    </aside>
  </div>
</div>

<script>
  import { headingAnchors } from "./client/heading-anchors";

  headingAnchors();
</script>

<style>
  :global([data-docs]) {
    font-family: "IBM Plex Sans", "Avenir Next", "Segoe UI", sans-serif;
  }

  :global([data-docs] h1),
  :global([data-docs] h2),
  :global([data-docs] h3) {
    font-family: "IBM Plex Serif", Georgia, serif;
    letter-spacing: -0.02em;
  }

  .docs-sidebar,
  .docs-toc,
  .docs-mobile-nav,
  .docs-mobile-toc {
    display: none;
  }

  .docs-mobile-nav,
  .docs-mobile-toc {
    display: block;
  }

  @media (min-width: 64rem) {
    .docs-sidebar {
      display: block;
    }

    .docs-mobile-nav {
      display: none;
    }
  }

  @media (min-width: 80rem) {
    .docs-toc {
      display: block;
    }

    .docs-mobile-toc {
      display: none;
    }
  }

  .docs-content {
    color: #c5c5c5;
    font-size: 1rem;
    line-height: 1.75;
  }

  .docs-content :global(.card .body) {
    color: #c5c5c5;
  }

  .docs-content :global(img) {
    height: auto;
    max-width: 100%;
  }

  .docs-content :global(h2:not([class])) {
    display: block;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--nb-foreground);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .docs-content :global(h3:not([class])) {
    display: block;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--nb-foreground);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .docs-content :global(h4:not([class])) {
    display: block;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--nb-foreground);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .docs-content > :global(p),
  .docs-content > :global(li) {
    color: var(--nb-foreground);
    font-size: 1rem;
    line-height: 1.75;
  }

  .docs-content > :global(p) {
    margin-block: 1rem;
  }

  .docs-content :global(ul),
  .docs-content :global(ol) {
    margin-block: 1rem;
    padding-left: 1.5rem;
  }

  .docs-content :global(ul) {
    list-style: disc;
  }

  .docs-content :global(ol) {
    list-style: decimal;
  }

  .docs-content > :global(a:not([data-docs-link-button])) {
    color: var(--nb-info);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .docs-content > :global(a:not([data-docs-link-button])):hover {
    color: var(--nb-primary-hover);
  }

  .docs-content :global(hr) {
    margin-block: 2.5rem;
    border-color: var(--nb-border);
  }

  .docs-content :global(.sl-heading-wrapper > .sl-anchor-link) {
    display: none;
  }

  .docs-content :global(table) {
    display: block;
    width: 100%;
    margin-block: 1.5rem 2rem;
    overflow-x: auto;
    border-spacing: 0;
    border-collapse: separate;
    border: 1px solid var(--nb-border);
    border-radius: 0.75rem;
    background: var(--nb-card);
  }

  .docs-content :global(thead),
  .docs-content :global(tbody) {
    display: table;
    width: 100%;
    table-layout: fixed;
  }

  .docs-content :global(thead) {
    background: var(--nb-muted);
  }

  .docs-content :global(th),
  .docs-content :global(td) {
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--nb-border);
    text-align: left;
    vertical-align: top;
  }

  .docs-content :global(th) {
    color: var(--nb-foreground);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .docs-content :global(td) {
    color: var(--nb-muted-foreground);
  }

  .docs-content :global(tr:last-child td) {
    border-bottom: 0;
  }

  .docs-content :global(.heading-anchor) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }

  .docs-content :global(.heading-anchor-label) {
    min-width: 0;
  }

  .docs-content :global(.heading-anchor-icon) {
    flex: 0 0 auto;
    color: var(--nb-muted-foreground);
    font-family: "IBM Plex Sans", "Avenir Next", "Segoe UI", sans-serif;
    font-size: 0.82em;
    font-weight: 600;
    opacity: 0;
    transform: translateX(-0.35rem);
    transition: opacity 160ms ease, transform 160ms ease, color 160ms ease;
  }

  .docs-content :global(.heading-anchor-icon svg) {
    display: block;
    width: 1em;
    height: 1em;
  }

  .docs-content :global(.heading-anchor:hover .heading-anchor-icon),
  .docs-content :global(.heading-anchor:focus-visible .heading-anchor-icon) {
    color: var(--nb-primary);
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .docs-content :global(.heading-anchor-icon) {
      transition: none;
    }
  }

</style>

---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  sectionLabel: string;
  sidebarItems: import("@data/docs-sidebar").DocsSidebarItem[];
  title: string;
  description: string;
  headings: Heading[];
}

import DocsSidebar from "./DocsSidebar.astro";

const { sectionLabel, sidebarItems, title, description, headings } = Astro.props;
const currentPath = Astro.url.pathname;
const visibleHeadings = headings.filter((heading) => heading.depth <= 3);
---

<div data-docs-next class="w-full bg-neutral-50 dark:bg-[#222222]">
  <div class="flex min-h-[calc(100vh-4rem)] w-full">
    <aside
      class="docs-next-sidebar hidden w-72 shrink-0 border-r border-neutral-200 bg-neutral-100/70 lg:block dark:border-[#383838] dark:bg-[#1d1d1d]"
      aria-label={`${sectionLabel} navigation`}
    >
      <div
        class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto px-6 py-8"
      >
        <p
          class="text-[0.68rem] font-bold tracking-[0.18em] text-neutral-500 uppercase dark:text-[#9aa7b5]"
        >
          Get started
        </p>
        <p class="mt-3 text-sm font-semibold text-neutral-900 dark:text-[#f4f4f4]">
          {sectionLabel}
        </p>
        <label class="relative mt-5 block">
          <span class="sr-only">Filter guide pages</span>
          <svg
            class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-neutral-400 dark:text-[#8c8c8c]"
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m14.5 14.5 3 3m-1.75-8.25a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
          <input
            type="search"
            data-docs-filter
             placeholder="Filter documentation"
            class="w-full rounded-lg border border-neutral-300 bg-white py-2 pr-3 pl-9 text-sm text-neutral-900 outline-none placeholder:text-neutral-400 focus:border-[#8da2b6] focus:ring-2 focus:ring-[#8da2b6]/20 dark:border-[#414141] dark:bg-[#262626] dark:text-[#f4f4f4] dark:placeholder:text-[#858585] dark:focus:border-[#9aaec1]"
          />
        </label>
        <nav class="mt-5" data-docs-nav aria-label="Documentation navigation">
          <DocsSidebar items={sidebarItems} currentPath={currentPath} />
        </nav>
      </div>
    </aside>

    <main id="main-content" class="min-w-0 flex-1">
       <div class="mx-auto max-w-5xl px-5 py-8 sm:px-8 sm:py-12 lg:px-12">
        <nav
            class="text-xs font-medium text-neutral-500 dark:text-[#9aa7b5]"
          aria-label="Breadcrumb"
        >
          <a
            href="/wiki-next/"
            class="hover:text-[#7890a6] dark:hover:text-[#b0c0cf]">Wiki</a
          >
          <span class="px-2" aria-hidden="true">/</span>
          <span>{sectionLabel}</span>
        </nav>

        <header
          class="mt-6 border-b border-neutral-200 pb-8 dark:border-[#383838]"
        >
          <p
            class="text-sm font-bold tracking-[0.16em] text-[#6e8499] uppercase dark:text-[#9aaec1]"
          >
            {sectionLabel}
          </p>
          <h1
            class="mt-3 text-4xl font-bold tracking-tight text-neutral-950 sm:text-5xl dark:text-[#f4f4f4]"
          >
            {title}
          </h1>
          <p
            class="mt-4 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-[#b8b8b8]"
          >
            {description}
          </p>
        </header>

        <details
          class="docs-next-mobile-nav mt-6 rounded-xl border border-neutral-200 bg-neutral-100 p-4 lg:hidden dark:border-[#383838] dark:bg-[#1d1d1d]"
        >
          <summary
            class="cursor-pointer text-sm font-semibold text-neutral-800 dark:text-[#f4f4f4]"
          >
            Browse documentation
          </summary>
          <nav
            class="mt-3 grid gap-1"
            aria-label="Documentation mobile navigation"
          >
            <DocsSidebar items={sidebarItems} currentPath={currentPath} />
          </nav>
        </details>

        {
          visibleHeadings.length > 0 && (
            <details class="docs-next-mobile-toc mt-4 rounded-xl border border-neutral-200 bg-neutral-100 p-4 xl:hidden dark:border-[#383838] dark:bg-[#1d1d1d]">
              <summary class="cursor-pointer text-sm font-semibold text-neutral-800 dark:text-[#f4f4f4]">
                On this page
              </summary>
              <nav class="mt-3 grid gap-2" aria-label="On this page">
                {visibleHeadings.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    class:list={[
                      "text-sm text-neutral-600 hover:text-[#6e8499] dark:text-[#b8b8b8] dark:hover:text-[#b0c0cf]",
                      heading.depth === 3 && "pl-4",
                    ]}
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
            </details>
          )
        }

        <article
          class="docs-next-content prose prose-neutral dark:prose-invert mt-10 max-w-none"
        >
          <slot />
        </article>
      </div>
    </main>

    <aside
      class="docs-next-toc hidden w-64 shrink-0 border-l border-neutral-200 xl:block dark:border-[#383838]"
      aria-label="On this page"
    >
      <div
        class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto px-6 py-12"
      >
        <p
          class="text-[0.68rem] font-bold tracking-[0.18em] text-neutral-500 uppercase dark:text-[#9aa7b5]"
        >
          On this page
        </p>
        <nav class="mt-4 grid gap-3">
          {
            visibleHeadings.map((heading) => (
              <a
                href={`#${heading.slug}`}
                class:list={[
                  "text-sm text-neutral-600 hover:text-[#6e8499] dark:text-[#b8b8b8] dark:hover:text-[#b0c0cf]",
                  heading.depth === 3 && "pl-3",
                ]}
              >
                {heading.text}
              </a>
            ))
          }
        </nav>
      </div>
    </aside>
  </div>
</div>

<style>
  @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap");

  :global([data-docs-next]) {
    font-family: "DM Sans", "Avenir Next", "Segoe UI", sans-serif;
  }

  :global([data-docs-next] h1),
  :global([data-docs-next] h2),
  :global([data-docs-next] h3) {
    font-family: "Newsreader", Georgia, serif;
    letter-spacing: -0.02em;
  }

  .docs-next-sidebar,
  .docs-next-toc,
  .docs-next-mobile-nav,
  .docs-next-mobile-toc {
    display: none;
  }

  .docs-next-mobile-nav,
  .docs-next-mobile-toc {
    display: block;
  }

  @media (min-width: 64rem) {
    .docs-next-sidebar {
      display: block;
    }

    .docs-next-mobile-nav {
      display: none;
    }
  }

  @media (min-width: 80rem) {
    .docs-next-toc {
      display: block;
    }

    .docs-next-mobile-toc {
      display: none;
    }
  }

  .docs-next-content :global(.sl-link-button) {
    margin-block: 0.5rem;
  }

  .docs-next-content :global(.sl-markdown-content) {
    color: inherit;
  }

  .docs-next-content :global(img) {
    height: auto;
    max-width: 100%;
  }

  .docs-next-content :global(h2:not([class])) {
    display: inline-block;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: #1f2937;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .docs-next-content :global(h3:not([class])) {
    display: inline-block;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: #1f2937;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .docs-next-content :global(h4:not([class])) {
    display: inline-block;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: #1f2937;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .docs-next-content :global(:is(h2, h3, h4):not([class]) + .sl-anchor-link) {
    display: inline-flex;
    width: 1.5rem;
    height: 1.5rem;
    margin-left: 0.4rem;
    vertical-align: middle;
    align-items: center;
    justify-content: center;
    border-radius: 0.35rem;
    color: #7890a6;
    opacity: 0;
    text-decoration: none;
    transform: translateY(-0.08em);
    transition: color 150ms ease, background-color 150ms ease, opacity 150ms ease;
  }

  .docs-next-content :global(:is(h2, h3, h4):not([class]):hover + .sl-anchor-link),
  .docs-next-content :global(.sl-anchor-link:hover),
  .docs-next-content :global(.sl-anchor-link:focus-visible) {
    opacity: 1;
  }

  .docs-next-content :global(.sl-anchor-link:hover) {
    background: color-mix(in oklch, #7890a6 12%, transparent);
    color: #536d85;
  }

  .docs-next-content :global(.sl-anchor-link:focus-visible) {
    outline: 2px solid #7890a6;
    outline-offset: 2px;
  }

  .docs-next-content :global(.sl-anchor-icon) {
    display: inline-flex;
  }

  .docs-next-content > :global(p),
  .docs-next-content > :global(li) {
    color: #374151;
    font-size: 1rem;
    line-height: 1.75;
  }

  .docs-next-content > :global(p) {
    margin-block: 1rem;
  }

  .docs-next-content :global(ul),
  .docs-next-content :global(ol) {
    margin-block: 1rem;
    padding-left: 1.5rem;
  }

  .docs-next-content :global(ul) {
    list-style: disc;
  }

  .docs-next-content :global(ol) {
    list-style: decimal;
  }

  .docs-next-content > :global(a:not(.sl-link-button):not([data-docs-link-button])) {
    color: #5f7890;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .docs-next-content > :global(a:not(.sl-link-button):not([data-docs-link-button])):hover {
    color: #49657d;
  }

  .docs-next-content :global(hr) {
    margin-block: 2.5rem;
    border-color: #d1d5db;
  }

  :global(.dark) .docs-next-content :global(h2:not([class])),
  :global(.dark) .docs-next-content :global(h3:not([class])),
  :global(.dark) .docs-next-content :global(h4:not([class])) {
    color: #f4f4f4;
  }

  :global(.dark) .docs-next-content > :global(p),
  :global(.dark) .docs-next-content > :global(li) {
    color: #c5c5c5;
  }

  :global(.dark) .docs-next-content > :global(a:not(.sl-link-button):not([data-docs-link-button])) {
    color: #a9bac9;
  }

  :global(.dark) .docs-next-content > :global(a:not(.sl-link-button):not([data-docs-link-button])):hover {
    color: #c4d2df;
  }

  :global(.dark) .docs-next-content :global(hr) {
    border-color: #383838;
  }
</style>

<script>
  const filter = document.querySelector<HTMLInputElement>("[data-docs-filter]");
  const items = Array.from(
    document.querySelectorAll<HTMLElement>("[data-docs-nav-item]"),
  );

  filter?.addEventListener("input", () => {
    const query = filter.value.trim().toLowerCase();

    items.forEach((item) => {
      const label = item.dataset.docsNavLabel?.toLowerCase() ?? "";
      item.hidden = query.length > 0 && !label.includes(query);
    });
  });
</script>

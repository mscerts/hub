---
import { Icon } from "astro-icon/components";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"aside"> {
  // Keeps `type` (not `variant`) for Starlight compatibility — Starlight's <Aside> uses `type`.
  type?: "note" | "tip" | "caution" | "danger";
  title?: string;
}

const { type = "note", title, class: className, ...attrs } = Astro.props;

const config: Record<string, { label: string; color: string; tint: string }> = {
  note: { label: "Note", color: "var(--nb-info)", tint: "var(--nb-info-muted)" },
  tip: { label: "Tip", color: "var(--nb-success)", tint: "var(--nb-success-muted)" },
  caution: { label: "Caution", color: "var(--nb-warning)", tint: "var(--nb-warning-muted)" },
  danger: { label: "Danger", color: "var(--nb-danger)", tint: "var(--nb-danger-muted)" },
};

const c = config[type] ?? config.note;
const displayTitle = title ?? c.label;
---

<aside
  role="note"
  aria-label={displayTitle}
  class={cn("aside-card my-4 rounded-xl px-4 py-3.5 sm:px-5", className)}
  style={`--_c: ${c.color}; --_t: ${c.tint};`}
  {...attrs}
>
  <span class="aside-card-icon" aria-hidden="true">
    {type === "note" && <Icon name="ph:info" class="w-[1em] h-[1em]" />}
    {type === "tip" && <Icon name="ph:lightbulb" class="w-[1em] h-[1em]" />}
    {type === "caution" && <Icon name="ph:warning" class="w-[1em] h-[1em]" />}
    {type === "danger" && <Icon name="ph:warning-circle" class="w-[1em] h-[1em]" />}
  </span>
  <div class="aside-card-content">
    <p class="aside-card-title">{displayTitle}</p>
    <div class="aside-card-body">
      <slot />
    </div>
  </div>
</aside>

<style>
  .aside-card {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.625rem;
    border: 1px solid color-mix(in oklch, var(--_c) 30%, var(--nb-border));
    border-left: 3px solid var(--_c);
    background: color-mix(in oklch, var(--nb-card) 92%, var(--_t));
    box-shadow: var(--nb-shadow-sm);
  }

  .aside-card-icon {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border: 1px solid color-mix(in oklch, var(--_c) 30%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in oklch, var(--_t) 75%, var(--nb-card));
    color: var(--_c);
  }

  .aside-card .aside-card-content { min-width: 0; }

  .aside-card .aside-card-title {
    margin: 0;
    color: var(--_c);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.75rem;
  }

  .aside-card .aside-card-body {
    margin-top: 0.375rem;
    color: var(--nb-foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .aside-card .aside-card-body :global(p) {
    margin: 0;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
  }
  .aside-card .aside-card-body :global(p + p) { margin-top: 0.375rem; }
  .aside-card-body :global(a) { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .aside-card-body :global(a:hover) { color: var(--_c); }

  /* Inline code only — exclude code inside Expressive Code pre blocks */
  .aside-card-body :global(code:not(:where(pre *))) {
    font-family: var(--nb-font-mono);
    font-size: 0.8125em;
    background: color-mix(in oklch, var(--_c) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--_c) 15%, transparent);
    border-radius: 0.25rem;
    padding: 0.0625rem 0.3125rem;
  }

  .aside-card-body :global(strong) { font-weight: 600; color: inherit; }
  .aside-card-body :global(.astro-code) { margin: 0.75rem 0; }
</style>

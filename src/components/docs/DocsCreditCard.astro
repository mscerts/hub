---
import { Image } from "astro:assets";
import mascotImage from "@/assets/images/mascot.png";
import { DISCORD_URL } from "@data/constants";
---

<aside class="docs-credit">
  <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer">
    <h2>Have more questions?</h2>
    <div>
      <p>Join our Discord server and ask away!</p>
      <Image src={mascotImage} alt="MSFTHub Mascot" width={180} />
    </div>
  </a>
</aside>

<style>
  .docs-credit {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(155 180 208 / 0.9);
    border-radius: 0.5rem;
    background: rgb(29 39 53 / 0.86);
    padding: 1rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.18);
  }

  .docs-credit a {
    color: inherit;
    text-decoration: none;
  }

  .docs-credit a::before {
    position: absolute;
    inset: 0;
    content: "";
  }

  .docs-credit a:focus-visible {
    border-radius: 0.375rem;
    outline: 2px solid #b9cde2;
    outline-offset: 2px;
  }

  .docs-credit h2 {
    margin: 0 0 0.5rem;
    color: #f4f4f4;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.25rem;
  }

  .docs-credit div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .docs-credit p {
    margin: 0;
    color: #9aa7b5;
    font-size: 0.75rem;
    line-height: 1.1rem;
    overflow-wrap: anywhere;
  }

  .docs-credit img {
    align-self: end;
    width: 4.75rem;
    height: auto;
    margin-bottom: -1rem;
    transform: translateY(2px);
    transition: transform 0.3s;
  }

  .docs-credit:hover img {
    transform: translateY(0);
  }
</style>

---
import DropdownButton from "@components/ui/DropdownButton.astro";

interface Action {
  label: string;
  href: string;
  icon: string;
}

const currentUrl = Astro.url.href;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(
  Astro.props.title ?? "Microsoft Certification Hub",
);
const prompt = encodeURIComponent(
  `Help me understand this page: ${currentUrl}`,
);

const aiActions: Action[] = [
  {
    label: "Open in ChatGPT",
    href: `https://chatgpt.com/?q=${prompt}`,
    icon: "openai",
  },
  {
    label: "Open in Claude",
    href: `https://claude.ai/new?q=${prompt}`,
    icon: "anthropic",
  },
  {
    label: "Open in Cursor",
    href: `https://cursor.com/link/prompt?${prompt}`,
    icon: "cursor",
  },
  {
    label: "Open in GitHub Copilot",
    href: `https://github.com/copilot/?prompt=${prompt}`,
    icon: "githubcopilot",
  },
];

if (
  currentPath !== "/certs" &&
  currentPath !== "/wiki" &&
  currentPath !== "/certs/archive"
) {
  aiActions.push({
    label: "View as Markdown",
    href: `${currentPath}.md`,
    icon: "markdown",
  });
}

const shareActions: Action[] = [
  {
    label: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: "linkedin",
  },
  {
    label: "X (Twitter)",
    href: `https://x.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    icon: "x",
  },
  {
    label: "Threads",
    href: `https://threads.net/intent/post?url=${encodedUrl}&text=${encodedTitle}`,
    icon: "threads",
  },
  {
    label: "Bluesky",
    href: `https://bsky.app/intent/compose?text=${encodedTitle}%20${encodedUrl}`,
    icon: "bluesky",
  },
  {
    label: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: "facebook",
  },
  {
    label: "Reddit",
    href: `https://reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`,
    icon: "reddit",
  },
  {
    label: "Hacker News",
    href: `https://news.ycombinator.com/submitlink?u=${encodedUrl}&t=${encodedTitle}`,
    icon: "ycombinator",
  },
  {
    label: "WhatsApp",
    href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
    icon: "whatsapp",
  },
];
---

<div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Page actions">
  <DropdownButton
    label="Ask AI"
    actions={aiActions.map((action) => ({
      ...action,
      icon: `simple-icons:${action.icon}`,
      target: "_blank" as const,
    }))}
  />
  <DropdownButton
    label="Share"
    actions={shareActions.map((action) => ({
      ...action,
      icon: `simple-icons:${action.icon}`,
      target: "_blank" as const,
    }))}
  />
</div>

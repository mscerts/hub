---
import { Icon } from "astro-icon/components";
import { Aside, Card, CardGrid, LinkCard } from "@components/docs";
import { bundlesForExam, examCodeOfPath } from "@utils/measureup-bundles.mjs";

interface Props {
  assessmentUrl?: string;
  practiceTestUrl?: string;
  // The hub's code of the exam; the card reads it from the address of the page when it is not given.
  examCode?: string;
}

const { assessmentUrl, practiceTestUrl, examCode } = Astro.props;
const bundles = bundlesForExam(examCode ?? examCodeOfPath(Astro.url.pathname));
// The bundles sit behind a dropdown whose trigger has the size and layout of a LinkCard (the same classes as
// the trigger of src/components/RelatedCerts.astro), so it reads as one more link of the card.
const SUMMARY_CLASS =
  "group not-prose hover:shadow-default flex cursor-pointer list-none items-center justify-between gap-3 rounded-xl border border-border bg-card p-4 text-inherit no-underline shadow-sm transition hover:border-border-strong sm:gap-4 sm:p-5 [&::-webkit-details-marker]:hidden";
const hasProductSlot = Astro.slots.has("products");
if (!hasProductSlot && (!assessmentUrl || !practiceTestUrl)) {
  throw new Error(
    "MeasureUpCard requires a products slot or both product URLs.",
  );
}

const ensureU44 = (url: string) => (url.includes("#u44") ? url : `${url}#u44`);
---

<Card title="MeasureUp Practice Tests" icon="open-book">
  {hasProductSlot ? (
    <slot name="products" />
  ) : (
    <CardGrid>
      <LinkCard
        title="MeasureUp Assessment"
        href={ensureU44(assessmentUrl!)}
        target="_blank"
      />
      <LinkCard
        title="MeasureUp Practice Test"
        href={ensureU44(practiceTestUrl!)}
        target="_blank"
      />
    </CardGrid>
  )}
  {bundles.length > 0 && (
    <details class="my-4">
      <summary class={SUMMARY_CLASS}>
        <span class="flex min-w-0 flex-1 items-start gap-2 sm:gap-3">
          <span
            class="border-border bg-muted text-card-foreground grid size-9 shrink-0 place-items-center rounded-lg border"
            aria-hidden="true"
          >
            <Icon name="ph:stack" class="size-4.5" />
          </span>
          <span class="min-w-0">
            <span class="text-card-foreground group-hover:text-primary block text-base leading-snug font-semibold transition-colors">
              Discounted bundles with other exams
            </span>
            <span class="text-muted-foreground mt-1 block text-sm leading-normal">
              MeasureUp practice tests for this exam and others in one purchase.
            </span>
          </span>
        </span>
        <Icon
          name="ph:caret-down"
          class="text-muted-foreground group-hover:text-primary size-4 shrink-0 transition-transform [details[open]>summary>&]:rotate-180"
          aria-hidden="true"
        />
      </summary>
      <div class="mt-4">
        <p>
          These bundles combine the practice test of this exam with those of
          other exams at a lower price. Our code <strong>MSFTHUB</strong> works
          on bundles too.
        </p>
        <CardGrid>
          {bundles.map((bundle) => (
            <LinkCard
              title={bundle.title}
              href={bundle.href}
              description={bundle.description}
              target="_blank"
            />
          ))}
        </CardGrid>
      </div>
    </details>
  )}
  <LinkCard
    title="MeasureUp Subscriptions"
    href="https://www.measureup.com/subscription-plans-for-individuals#u44"
    target="_blank"
  />
  <p>
    Official Microsoft Practice tests. They are expensive but they will prepare
    you for the exam. They are harder than normal exam questions but that helps
    even more to identify your weak areas and where you need to study more.
    There are also cheaper assessments but they contain less questions and no
    explanations.
  </p>

  <p>
    MeasureUp also offers subscriptions in case you are planning to take
    multiple exams in the next 12 months.
  </p>
  <slot name="before-discount" />
  <Aside type="tip">
    <p>
      Use our code <strong>MSFTHUB</strong> for an exclusive 15% discount on the
      MeasureUp store!
    </p>
  </Aside>
  <slot />
</Card>

---
// The two versions of a study guide course (docs/course-next.md): while a change of the skills measured is
// upcoming, the page of a course has a tab for the course in force and a tab for the upcoming course. From the
// effective day on it is the upcoming course alone, without marks. The build decides, and the script below
// decides again in the browser, so a page built before the day is still right on it.
import { Tabs, TabItem } from "@components/docs";
import { daysUntil } from "@utils/guide-change-date.mjs";

interface Props {
  /** The day the upcoming skills count from, YYYY-MM-DD (UTC). */
  effective: string;
  currentLabel: string;
  upcomingLabel: string;
}
const { effective, currentLabel, upcomingLabel } = Astro.props;
const flipped = daysUntil(effective) <= 0;
---

<div
  class="course-versions"
  data-course-versions
  data-effective={effective}
  data-flipped={flipped ? "" : undefined}
  id={flipped ? undefined : "upcoming"}
>
  {
    flipped ? (
      <slot name="upcoming" />
    ) : (
      <>
        <div class="course-legend">
          <slot name="intro" />
        </div>
        <Tabs>
          <TabItem label={currentLabel}>
            <slot name="current" />
          </TabItem>
          <TabItem label={upcomingLabel}>
            {/* search finds the course in force until the effective day (the page is rendered without this wrapper from then on) */}
            <div data-pagefind-ignore>
              <slot name="upcoming" />
            </div>
          </TabItem>
        </Tabs>
      </>
    )
  }
</div>

<script>
  import { daysUntil } from "@utils/guide-change-date.mjs";

  const roots = document.querySelectorAll<HTMLElement>(
    "[data-course-versions]",
  );

  // the strip of the two tabs of one course page, not the tabs of a task inside them
  const triggersOf = (root: HTMLElement) =>
    Array.from(
      root.querySelectorAll<HTMLElement>(
        ":scope > [data-docs-tabs] > [data-docs-tabs-scroll] [data-docs-tabs-trigger]",
      ),
    );

  const showUpcoming = (root: HTMLElement, preserveHash = false) => {
    const savedUrl = preserveHash
      ? `${location.pathname}${location.search}${location.hash}`
      : null;
    // after the tabs script has set itself up
    requestAnimationFrame(() => {
      triggersOf(root)[1]?.click();
      if (savedUrl) history.replaceState(null, "", savedUrl);
    });
  };

  for (const root of roots) {
    const effective = root.dataset.effective;
    if (!effective) continue;
    // a page built before the effective day, opened on it or later: the upcoming course is the course
    if (!root.hasAttribute("data-flipped") && daysUntil(effective) <= 0) {
      root.setAttribute("data-flipped", "");
      root.removeAttribute("id");
      showUpcoming(root, location.hash !== "#upcoming");
      continue;
    }
    // the exam page's banner links #upcoming: open that tab
    const openFromHash = () => {
      if (location.hash === "#upcoming") showUpcoming(root);
    };
    openFromHash();
    window.addEventListener("hashchange", openFromHash);
  }
</script>

<style is:global>
  /*
   * The marks of a course with two versions. Colour is never the only cue: every mark is also text. They exist
   * only while both versions are shown: from the effective day on the container is [data-flipped] and the marks
   * and notes disappear. Unlayered, so they win over the utility classes of the cards.
   */
  .course-versions[data-flipped] .course-legend,
  .course-versions[data-flipped] .course-mark,
  .course-versions[data-flipped] .docs-link-card__tag,
  .course-versions[data-flipped] > [data-docs-tabs] > [data-docs-tabs-scroll] {
    display: none;
  }

  .course-mark {
    display: inline-block;
    border: 1px solid;
    border-radius: 0.375rem;
    padding: 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
    vertical-align: middle;
  }
  .course-mark--added,
  .docs-link-card[data-change="added"] .docs-link-card__tag {
    border-color: #16a34a;
    background: #f0fdf4;
    color: #166534;
  }
  .course-mark--removed,
  .docs-link-card[data-change="removed"] .docs-link-card__tag {
    border-color: #dc2626;
    background: #fef2f2;
    color: #991b1b;
  }
  .course-mark--neutral {
    border-color: color-mix(in srgb, currentColor 30%, transparent);
    opacity: 0.85;
  }
  .course-versions:not([data-flipped]) .course-ins {
    color: #15803d;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .course-versions:not([data-flipped]) .course-leaves {
    color: #dc2626;
  }
  .course-versions:not([data-flipped]) .docs-link-card[data-change="added"] {
    border-color: #16a34a;
    background: #f0fdf4;
  }
  .course-versions:not([data-flipped]) .docs-link-card[data-change="removed"] {
    border-color: #dc2626;
    background: #fef2f2;
  }

  :is(.dark) .course-mark--added,
  :is(.dark) .docs-link-card[data-change="added"] .docs-link-card__tag {
    border-color: #4ade80;
    background: rgb(5 46 22 / 0.4);
    color: #86efac;
  }
  :is(.dark) .course-mark--removed,
  :is(.dark) .docs-link-card[data-change="removed"] .docs-link-card__tag {
    border-color: #f87171;
    background: rgb(69 10 10 / 0.4);
    color: #fca5a5;
  }
  :is(.dark) .course-versions:not([data-flipped]) .course-ins {
    color: #4ade80;
  }
  :is(.dark) .course-versions:not([data-flipped]) .course-leaves {
    color: #f87171;
  }
  :is(.dark)
    .course-versions:not([data-flipped])
    .docs-link-card[data-change="added"] {
    border-color: #4ade80;
    background: rgb(5 46 22 / 0.4);
  }
  :is(.dark)
    .course-versions:not([data-flipped])
    .docs-link-card[data-change="removed"] {
    border-color: #f87171;
    background: rgb(69 10 10 / 0.4);
  }
</style>

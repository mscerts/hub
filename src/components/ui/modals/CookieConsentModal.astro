---
// Cookie Consent Modal Component
// Provides a comprehensive UI for cookie consent management
---

<div id="cookie-consent-modal" class="cookie-consent-modal hidden">
  <!-- Backdrop -->
  <div class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 transition-opacity duration-300" id="consent-backdrop"></div>
  
  <!-- Modal -->
  <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <div
      class="bg-white dark:bg-neutral-800 rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto border border-neutral-200 dark:border-neutral-700"
      role="dialog"
      aria-modal="true"
      aria-labelledby="cookie-preferences-title"
    >
      <!-- Header -->
      <div class="p-6 border-b border-neutral-200 dark:border-neutral-700">
        <div class="flex items-center justify-between">
          <h2 id="cookie-preferences-title" class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">
            🍪 Cookie Preferences
          </h2>
          <button
            id="close-modal"
            class="text-neutral-400 hover:text-neutral-600 transition-colors p-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 dark:text-neutral-300 dark:hover:text-white dark:focus-visible:outline-blue-300"
            aria-label="Close modal"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2">
          We use cookies to enhance your browsing experience and analyze our traffic. Choose your preferences below.
        </p>
      </div>

      <!-- Content -->
      <div class="p-6 space-y-6">
        <!-- Essential Cookies (Always Active) -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <h3 class="font-medium text-neutral-900 dark:text-neutral-100">
                Essential Cookies
              </h3>
               <p id="analytics-description" class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">
                Required for basic website functionality. These cannot be disabled.
              </p>
            </div>
            <div class="flex items-center">
              <span class="text-xs px-2 py-1 rounded-full dark:text-neutral-100">
                Always Active
              </span>
            </div>
          </div>
        </div>

        <!-- Analytics Cookies -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <h3 class="font-medium text-neutral-900 dark:text-neutral-100">
                Analytics Cookies
              </h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">
                Help us understand how visitors interact with our website by collecting and reporting information anonymously.
              </p>
               <div class="mt-2 text-xs text-neutral-600 dark:text-neutral-400">
                <span class="font-medium">Providers:</span> Microsoft Clarity and Google Analytics
              </div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer" aria-label="Allow analytics cookies">
              <input
                 type="checkbox"
                 id="analytics-toggle"
                 class="sr-only peer"
                 aria-describedby="analytics-description"
              >
              <div class="w-11 h-6 bg-neutral-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 rounded-full peer dark:bg-neutral-600 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-neutral-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-neutral-600 peer-checked:bg-blue-600"></div>
            </label>
          </div>
        </div>

        <!-- Privacy Policy Link -->
        <div class="bg-neutral-50 dark:bg-neutral-900 rounded-lg p-4">
          <p class="text-xs text-neutral-600 dark:text-neutral-400">
            For more information about how we use cookies, please read our 
             <a href="/privacy" class="text-blue-600 dark:text-blue-400 underline hover:no-underline">Privacy Policy</a>
          </p>
        </div>
      </div>

      <!-- Footer Actions -->
      <div class="p-6 border-t border-neutral-200 dark:border-neutral-700">
        <div class="flex flex-col sm:flex-row gap-3 sm:justify-end">
           <button
             id="save-preferences"
             type="button"
            class="px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-700 hover:bg-neutral-200 dark:hover:bg-neutral-600 rounded-lg transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 dark:focus-visible:outline-blue-300"
          >
             Save Preferences
           </button>
           <button
             id="reject-all"
             type="button"
              class="px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-700 hover:bg-neutral-200 dark:hover:bg-neutral-600 rounded-lg transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 dark:focus-visible:outline-blue-300"
           >
             Reject All
           </button>
           <button
             id="accept-all"
             type="button"
             class="px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-700 hover:bg-neutral-200 dark:hover:bg-neutral-600 rounded-lg transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 dark:focus-visible:outline-blue-300"
          >
            Accept All
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .cookie-consent-modal {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0s linear 0.3s;
  }

  .cookie-consent-modal.show {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease, visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-consent-modal,
    #consent-backdrop {
      transition: none !important;
    }
  }

  /* Prevent body scroll when modal is open */
  body.modal-open {
    overflow: hidden;
  }
</style>

<script>
  import { cookieConsentManager } from '../../../utils/cookieConsent.ts';
  
  class CookieConsentModal {
    private modal: HTMLElement;
    private backdrop: HTMLElement;
    private analyticsToggle: HTMLInputElement;
    private previousFocus: HTMLElement | null = null;

    constructor() {
      this.modal = document.getElementById('cookie-consent-modal')!;
      this.backdrop = document.getElementById('consent-backdrop')!;
      this.analyticsToggle = document.getElementById('analytics-toggle') as HTMLInputElement;

      this.bindEvents();
      this.loadCurrentPreferences();
    }

    private bindEvents(): void {
      // Close modal events
      document.getElementById('close-modal')?.addEventListener('click', () => this.hide());
      this.backdrop.addEventListener('click', () => this.hide());

      // Escape key to close
      document.addEventListener('keydown', (e) => {
        if (!this.isVisible()) return;

        if (e.key === 'Escape') {
          e.preventDefault();
          this.hide();
          return;
        }

        if (e.key !== 'Tab') return;

        const dialog = this.modal.querySelector<HTMLElement>('[role="dialog"]');
        const focusable = dialog
          ? Array.from(
              dialog.querySelectorAll<HTMLElement>(
                'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
              ),
            ).filter((element) => element.getClientRects().length > 0)
          : [];
        const first = focusable[0];
        const last = focusable.at(-1);

        if (!first || !last || !dialog) {
          e.preventDefault();
          return;
        }

        if (
          e.shiftKey &&
          (document.activeElement === first || !dialog.contains(document.activeElement))
        ) {
          e.preventDefault();
          last.focus();
        } else if (
          !e.shiftKey &&
          (document.activeElement === last || !dialog.contains(document.activeElement))
        ) {
          e.preventDefault();
          first.focus();
        }
      });

      // Button events
      document.getElementById('accept-all')?.addEventListener('click', () => {
        cookieConsentManager.acceptAll();
        this.hide();
      });

       document.getElementById('save-preferences')?.addEventListener('click', () => {
         this.savePreferences();
       });

       document.getElementById('reject-all')?.addEventListener('click', () => {
         cookieConsentManager.rejectAll();
         this.hide();
       });

      // Toggle change events
      this.analyticsToggle.addEventListener('change', () => {
        this.updateToggleState();
      });
    }

    private loadCurrentPreferences(): void {
      const preferences = cookieConsentManager.getPreferences();
      if (preferences) {
        this.analyticsToggle.checked = preferences.analytics_storage === 'granted';
      } else {
         this.analyticsToggle.checked = false;
      }
    }

    private updateToggleState(): void {
      // Visual feedback could be added here
    }

    private savePreferences(): void {
      cookieConsentManager.setConsent({
        analytics_storage: this.analyticsToggle.checked ? 'granted' : 'denied'
      });
      this.hide();
    }

    show(): void {
      if (this.isVisible()) return;

      this.previousFocus =
        document.activeElement instanceof HTMLElement &&
        !this.modal.contains(document.activeElement)
          ? document.activeElement
          : null;
      this.modal.classList.remove('hidden');
      document.body.classList.add('modal-open');
      
      // Trigger reflow for animation
      this.modal.offsetHeight;
      
      this.modal.classList.add('show');
      this.loadCurrentPreferences();
      const closeButton = this.modal.querySelector<HTMLButtonElement>("#close-modal");
      closeButton?.focus({ preventScroll: true });
      requestAnimationFrame(() => {
        if (this.isVisible()) closeButton?.focus({ preventScroll: true });
      });
    }

    hide(): void {
      this.modal.classList.remove('show');
      document.body.classList.remove('modal-open');

      const restoreFocus = () => {
        this.modal.classList.add('hidden');
        const previous = this.previousFocus;
        this.previousFocus = null;
        const previousIsVisible =
          previous?.isConnected &&
          previous.getClientRects().length > 0 &&
          getComputedStyle(previous).visibility !== 'hidden';
        const fallback = document.getElementById('cookie-preferences-btn');
        (previousIsVisible ? previous : fallback)?.focus();
      };
      const duration = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ? 0
        : 300;
      window.setTimeout(restoreFocus, duration);
      window.dispatchEvent(new CustomEvent('cookiePreferencesClosed'));
    }

    isVisible(): boolean {
      return this.modal.classList.contains('show');
    }
  }

  declare global {
    interface Window {
      cookieConsentModal?: CookieConsentModal;
    }
  }

  const initializeCookieConsentModal = () => {
    if (window.cookieConsentModal) return;

     const modal = new CookieConsentModal();
    
    // Make modal globally available
    window.cookieConsentModal = modal;
    
  };

  window.addEventListener('openCookiePreferences', () => {
    initializeCookieConsentModal();
    window.cookieConsentModal?.show();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeCookieConsentModal, { once: true });
  } else {
    initializeCookieConsentModal();
  }
  document.addEventListener('astro:page-load', initializeCookieConsentModal);
</script>

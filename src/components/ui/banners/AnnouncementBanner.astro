---
interface Props {
  message: string;
  href?: string;
  linkLabel?: string;
  version: string;
}

const { message, href, linkLabel, version } = Astro.props;
---

<site-announcement
  class="site-announcement border-b border-blue-200 bg-blue-50 text-blue-950 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-100"
  data-version={version}
  role="region"
  aria-label="Site announcement"
>
  <script is:inline>
    (() => {
      const banner = document.currentScript.parentElement;
      try {
        if (
          localStorage.getItem(
            `hub-announcement-dismissed-v${banner.dataset.version}`,
          )
        ) {
          banner.hidden = true;
        }
      } catch {
        // Storage can be unavailable; the announcement should still be readable.
      }
    })();
  </script>
  <div class="mx-auto flex max-w-(--breakpoint-2xl) items-center gap-3 px-4 py-2 text-sm sm:px-6 lg:px-8">
    <p class="min-w-0 flex-1 text-center leading-6">
      {message}
      {href && linkLabel && (
        <a
          class="ml-2 rounded-sm font-semibold underline underline-offset-4 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2"
          href={href}
        >
          {linkLabel}
        </a>
      )}
    </p>
    <button
      type="button"
      data-dismiss-announcement
      aria-label="Dismiss announcement"
      class="flex size-8 shrink-0 items-center justify-center rounded-md hover:bg-blue-100 focus-visible:outline-2 focus-visible:outline-offset-2 dark:hover:bg-blue-900"
    >
      <svg
        aria-hidden="true"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
  </div>
</site-announcement>

<style>
  .site-announcement {
    display: block;
  }
  .site-announcement[hidden] {
    display: none !important;
  }
  @media print {
    .site-announcement {
      display: none !important;
    }
  }
</style>

<script>
  class SiteAnnouncement extends HTMLElement {
    connectedCallback() {
      this.querySelector<HTMLButtonElement>(
        "[data-dismiss-announcement]",
      )?.addEventListener("click", () => {
        this.hidden = true;
        try {
          localStorage.setItem(
            `hub-announcement-dismissed-v${this.dataset.version}`,
            "true",
          );
        } catch {
          // Dismissal still works for this page when persistent storage is blocked.
        }
      });
    }
  }

  if (!customElements.get("site-announcement")) {
    customElements.define("site-announcement", SiteAnnouncement);
  }
</script>

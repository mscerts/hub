---
import { Icon } from "astro-icon/components";

const searchId = "site-search-dialog";
---

<button
  data-search-trigger
  data-pagefind-ignore
  type="button"
  class="group flex h-9 w-9 items-center justify-center gap-2 rounded-lg border border-transparent text-neutral-600 outline-hidden transition hover:bg-neutral-100 hover:text-[#7890a6] focus-visible:ring-2 focus-visible:ring-[#8da2b6] md:w-72 md:justify-start md:border-neutral-200 md:bg-neutral-50/70 md:px-3 lg:absolute lg:left-1/2 lg:w-[22rem] lg:-translate-x-1/2 xl:w-[26rem] dark:text-neutral-300 dark:hover:bg-neutral-800 dark:md:border-neutral-700 dark:md:bg-[#252525] dark:hover:text-[#b0c0cf]"
  aria-label="Search documentation"
  aria-keyshortcuts="Control+K"
  aria-controls={searchId}
>
  <Icon name="ph:magnifying-glass" class="size-4 shrink-0" aria-hidden="true" />
  <span class="hidden flex-1 text-left text-sm font-medium md:block">Search</span>
  <kbd class="hidden items-center gap-0.5 rounded border border-neutral-300 bg-white/60 px-1.5 py-0.5 text-[0.625rem] font-medium text-neutral-500 md:inline-flex dark:border-neutral-600 dark:bg-[#2d2d2d] dark:text-neutral-400">
    <span data-shortcut-key>Ctrl</span> K
  </kbd>
</button>

<dialog
  id={searchId}
  data-search-dialog
  data-pagefind-ignore
  class="fixed inset-0 z-[100] m-0 h-full max-h-full w-full max-w-full bg-transparent p-0 backdrop:bg-black/70"
  aria-label="Search documentation"
>
  <div data-search-overlay class="flex min-h-full items-start justify-center overflow-y-auto p-4 pt-[10vh] sm:p-6 sm:pt-[12vh]">
    <div class="w-full max-w-xl overflow-hidden rounded-lg border border-neutral-700 bg-[#171717] text-neutral-100 shadow-2xl shadow-black/50 ring-1 ring-neutral-600/40">
      <div class="flex flex-col overflow-hidden rounded-t-lg border-b border-neutral-700 bg-[#222222]">
        <div class="flex items-center gap-3 border-b border-neutral-700 px-4 py-3">
          <Icon name="ph:magnifying-glass" class="size-4 shrink-0 text-neutral-400" aria-hidden="true" />
          <input
            data-search-input
            role="combobox"
            aria-expanded="false"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            aria-controls="search-listbox"
            type="text"
            placeholder="Search documentation..."
            class="min-w-0 flex-1 border-0 bg-transparent text-sm text-neutral-100 placeholder:text-neutral-500 focus:outline-none"
            autocomplete="off"
            spellcheck="false"
            autocorrect="off"
            autocapitalize="none"
          />
          <button
            type="button"
            data-search-close
            class="rounded border border-neutral-700 bg-[#2a2a2a] px-1.5 py-0.5 text-xs font-medium text-neutral-400 transition-colors hover:bg-[#343434] hover:text-neutral-100 focus-visible:ring-2 focus-visible:ring-[#8da2b6] focus-visible:outline-none"
          >
            Esc
          </button>
        </div>

        <div
          data-search-results
          role="listbox"
          id="search-listbox"
          aria-orientation="vertical"
          class="max-h-[min(32rem,55vh)] min-h-40 overflow-y-auto p-2"
        >
          <p data-search-empty class="py-8 text-center text-sm text-neutral-500">
            Type to search...
          </p>
        </div>
      </div>

      <div class="flex items-center gap-4 px-4 py-2.5 text-xs text-neutral-500">
        <span>↑↓ navigate</span>
        <span>↵ select</span>
        <span>Esc close</span>
      </div>
    </div>
  </div>
</dialog>

<script>
  interface PagefindSubResult {
    title?: string;
    url?: string;
  }

  interface PagefindResultData {
    url: string;
    excerpt?: string;
    meta?: { title?: string };
    sub_results?: PagefindSubResult[];
  }

  interface PagefindSearchResponse {
    results: Array<{ data(): Promise<PagefindResultData> }>;
  }

  interface PagefindApi {
    init(): Promise<void>;
    search(query: string): Promise<PagefindSearchResponse>;
  }

  type SearchResult = {
    title: string;
    url: string;
    snippet?: string;
    subResults: Array<{ title: string; url: string }>;
  };

  let pagefind: PagefindApi | undefined;
  let globalsBound = false;

  const getElements = () => ({
    dialog: document.querySelector<HTMLDialogElement>("[data-search-dialog]"),
    input: document.querySelector<HTMLInputElement>("[data-search-input]"),
    results: document.querySelector<HTMLElement>("[data-search-results]"),
    empty: document.querySelector<HTMLElement>("[data-search-empty]"),
    overlay: document.querySelector<HTMLElement>("[data-search-overlay]"),
  });

  const loadPagefind = async () => {
    if (pagefind) return pagefind;

    const baseUrl = new URL(import.meta.env.BASE_URL ?? "/", window.location.origin);
    const pagefindUrl = new URL("pagefind/pagefind.js", baseUrl);
    pagefind = (await import(/* @vite-ignore */ pagefindUrl.href)) as PagefindApi;
    await pagefind.init();
    return pagefind;
  };

  const clearResults = (input: HTMLInputElement, results: HTMLElement) => {
    results.querySelectorAll<HTMLElement>("[role='option']").forEach((result) => result.remove());
    input.setAttribute("aria-expanded", "false");
    input.removeAttribute("aria-activedescendant");
  };

  const buildResult = (result: SearchResult, index: number) => {
    const option = document.createElement("div");
    option.id = `search-result-${index}`;
    option.setAttribute("role", "option");
    option.className = "cursor-pointer rounded-lg px-2 py-2 transition-colors hover:bg-[#2d2d2d] focus-within:bg-[#2d2d2d]";

    const link = document.createElement("a");
    link.href = result.url;
    link.className = "block truncate text-sm font-medium text-neutral-100 no-underline outline-none";
    link.textContent = result.title;
    option.appendChild(link);

    if (result.snippet) {
      const snippet = document.createElement("p");
      snippet.className = "mt-1 line-clamp-2 text-xs leading-relaxed text-neutral-400";
      snippet.innerHTML = result.snippet;
      option.appendChild(snippet);
    }

    if (result.subResults.length > 0) {
      const subList = document.createElement("div");
      subList.className = "mt-2 border-l border-neutral-700 pl-3";
      result.subResults.slice(0, 3).forEach((subResult) => {
        const subLink = document.createElement("a");
        subLink.href = subResult.url;
        subLink.className = "block truncate py-0.5 text-xs text-neutral-500 no-underline hover:text-neutral-200";
        subLink.textContent = subResult.title;
        subList.appendChild(subLink);
      });
      option.appendChild(subList);
    }

    option.addEventListener("click", (event) => {
      if ((event.target as Element | null)?.closest("a")) return;
      link.click();
    });

    return option;
  };

  const initializeSearch = () => {
    const { dialog, input, results, empty, overlay } = getElements();
    const trigger = document.querySelector<HTMLButtonElement>("[data-search-trigger]");
    const closeButton = document.querySelector<HTMLButtonElement>("[data-search-close]");

    if (!dialog || !input || !results || !empty || !overlay || !trigger || !closeButton || dialog.dataset.ready) return;
    dialog.dataset.ready = "true";
    const closeButtonElement = closeButton;

    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const platform = nav.userAgentData?.platform ?? navigator.userAgent;
    if (/mac|iphone|ipod|ipad/i.test(platform)) {
      trigger.setAttribute("aria-keyshortcuts", "Meta+K");
      trigger.querySelector<HTMLElement>("[data-shortcut-key]")!.textContent = "⌘";
    }

    let activeIndex = -1;
    let searchTimer: ReturnType<typeof setTimeout> | undefined;
    let activeController: AbortController | undefined;

    const options = () => Array.from(results.querySelectorAll<HTMLElement>("[role='option']"));

    const updateActive = (nextIndex: number) => {
      const items = options();
      activeIndex = items.length === 0 ? -1 : Math.max(-1, Math.min(nextIndex, items.length - 1));
      items.forEach((item, index) => {
        if (index === activeIndex) {
          item.dataset.highlighted = "true";
          item.scrollIntoView({ block: "nearest" });
          input.setAttribute("aria-activedescendant", item.id);
        } else {
          delete item.dataset.highlighted;
        }
      });
      if (activeIndex < 0) input.removeAttribute("aria-activedescendant");
    };

    const reset = () => {
      activeController?.abort();
      if (searchTimer) clearTimeout(searchTimer);
      input.value = "";
      clearResults(input, results);
      empty.hidden = false;
      empty.textContent = "Type to search...";
      activeIndex = -1;
    };

    const runSearch = async (query: string) => {
      activeController?.abort();
      activeController = new AbortController();
      const signal = activeController.signal;
      empty.hidden = false;
      empty.textContent = "Searching...";
      clearResults(input, results);

      try {
        const api = await loadPagefind();
        if (signal.aborted) return;
        const response = await api.search(query);
        if (signal.aborted) return;
        const data = await Promise.all(response.results.slice(0, 10).map((result) => result.data()));
        const mapped: SearchResult[] = data.map((result) => ({
          title: result.meta?.title ?? "Untitled",
          url: result.url,
          snippet: result.excerpt,
          subResults: (result.sub_results ?? []).filter(
            (subResult): subResult is Required<PagefindSubResult> => Boolean(subResult.title && subResult.url),
          ),
        }));

        if (mapped.length === 0) {
          empty.hidden = false;
          empty.textContent = "No results found.";
          return;
        }

        empty.hidden = true;
        input.setAttribute("aria-expanded", "true");
        mapped.forEach((result, index) => results.appendChild(buildResult(result, index)));
      } catch {
        if (signal.aborted) return;
        empty.hidden = false;
        empty.textContent = "Search is temporarily unavailable.";
      }
    };

    const open = () => {
      if (!dialog.open) dialog.showModal();
      reset();
      input.focus();
    };

    const close = () => {
      if (dialog.open) dialog.close();
    };

    trigger.addEventListener("click", open);
    closeButtonElement.addEventListener("click", close);
    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) close();
    });
    input.addEventListener("input", () => {
      if (searchTimer) clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        const query = input.value.trim();
        if (!query) {
          reset();
          return;
        }
        void runSearch(query);
      }, 150);
    });
    dialog.addEventListener("keydown", (event) => {
      const items = options();
      if (event.key === "ArrowDown") {
        event.preventDefault();
        updateActive(activeIndex + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        updateActive(activeIndex - 1);
      } else if (event.key === "Home") {
        event.preventDefault();
        updateActive(0);
      } else if (event.key === "End") {
        event.preventDefault();
        updateActive(items.length - 1);
      } else if (event.key === "Enter" && activeIndex >= 0) {
        event.preventDefault();
        items[activeIndex]?.querySelector<HTMLAnchorElement>("a")?.click();
      }
    });
  };

  const bindGlobals = () => {
    if (globalsBound) return;
    globalsBound = true;
    window.addEventListener("keydown", (event) => {
      if (!(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== "k") return;
      const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
      if (!dialog) return;
      event.preventDefault();
      if (dialog.open) dialog.close();
      else document.querySelector<HTMLButtonElement>("[data-search-trigger]")?.click();
    });
  };

  document.addEventListener("astro:page-load", initializeSearch);
  initializeSearch();
  bindGlobals();
</script>

<style>
  [data-search-dialog]::backdrop {
    backdrop-filter: blur(6px);
  }

  [data-search-results] [data-highlighted="true"] {
    background: #2d2d2d;
  }

  [data-search-results] mark {
    background: #e7d84b;
    color: #171717;
  }

  [data-search-results] a:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid #9bb4d0;
    outline-offset: 2px;
  }
</style>

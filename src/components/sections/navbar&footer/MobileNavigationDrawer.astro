---
import DocsSidebar from "@components/docs/DocsSidebar.astro";
import Icon from "@components/ui/icons/Icon.astro";
import MegaMenuLink from "@components/ui/links/MegaMenuLink.astro";
import NavLink from "@components/ui/links/NavLink.astro";
import { docsSidebar } from "@data/docs-sidebar";
import { DISCORD_URL } from "@data/constants";
import strings from "@utils/navigation.ts";

interface Props {
  currentPath: string;
  isDocsPage: boolean;
}

const { currentPath, isDocsPage } = Astro.props;
const redditLinks = [
  {
    name: "r/O365Certification",
    url: "https://www.reddit.com/r/O365Certification/",
  },
  {
    name: "r/SCICertifications",
    url: "https://www.reddit.com/r/SCICertifications/",
  },
  {
    name: "r/AzureCertifications",
    url: "https://www.reddit.com/r/AzureCertifications/",
  },
];
---

<div class="mobile-nav-layer" data-mobile-nav-layer aria-hidden="true">
  <button
    type="button"
    class="mobile-nav-backdrop"
    data-mobile-nav-close
    tabindex="-1"
    aria-label="Close site navigation"></button>
  <div
    id="mobile-site-navigation-drawer"
    class="mobile-nav-drawer border-l border-neutral-200 bg-white shadow-2xl shadow-black/25 dark:border-neutral-700 dark:bg-neutral-900"
    data-mobile-nav-drawer
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
    aria-hidden="true"
    inert
  >
    <div
      class="flex shrink-0 items-center justify-between border-b border-neutral-200 px-5 py-4 dark:border-neutral-700"
    >
      <h2 class="m-0 text-base font-semibold text-neutral-900 dark:text-white">
        Navigation
      </h2>
      <button
        type="button"
        class="flex size-9 items-center justify-center rounded-lg text-neutral-500 transition hover:bg-neutral-100 hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-white"
        data-mobile-nav-close
        data-mobile-nav-close-button
        aria-label="Close site navigation"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="m6 6 12 12M18 6 6 18"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="1.8"></path>
        </svg>
      </button>
    </div>
    <div
      class="subtle-scrollbar min-h-0 flex-1 overflow-y-auto px-4 py-5"
      data-subtle-scrollbar
    >
      <nav aria-label="Site navigation">
        <div class="grid gap-1">
          {
            strings.navBarLinks.map((link) =>
              link.name === "Certifications" ? (
                <MegaMenuLink />
              ) : (
                <NavLink url={link.url} name={link.name} idPrefix="mobile-" />
              ),
            )
          }
        </div>
      </nav>

      <section
        class="mt-5 border-t border-neutral-200 pt-4 dark:border-neutral-700"
      >
        <h3
          class="mb-2 px-3 text-xs font-semibold tracking-wide text-neutral-500 uppercase dark:text-neutral-400"
        >
          Community
        </h3>
        <div class="flex items-center gap-1 px-3">
          <a
            href={DISCORD_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="flex size-9 items-center justify-center rounded-lg text-neutral-600 outline-hidden transition hover:bg-neutral-100 hover:text-blue-700 focus-visible:ring-2 focus-visible:ring-orange-700 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-blue-300 dark:focus-visible:ring-orange-300"
            aria-label="Join the Microsoft Certification Hub Discord"
          >
            <span aria-hidden="true">
              <Icon
                name="discord"
                class="!fill-[#5865F2] dark:!fill-[#7289DA]"
              />
            </span>
          </a>
          <button
            type="button"
            class="group flex size-9 items-center justify-center rounded-lg text-neutral-600 outline-hidden transition hover:bg-neutral-100 focus-visible:ring-2 focus-visible:ring-orange-700 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:ring-orange-300"
            id="mobile-reddit-menu-toggle"
            data-reddit-menu-toggle
            aria-label="Open Microsoft certification subreddits"
            aria-controls="mobile-reddit-menu"
            aria-expanded="false"
          >
            <span aria-hidden="true">
              <Icon
                name="reddit"
                class="!fill-[#FF4500] transition-colors dark:!fill-[#FF5700]"
              />
            </span>
          </button>
        </div>
        <div
          id="mobile-reddit-menu"
          data-reddit-menu
          hidden
          class="mt-2 grid gap-1 rounded-xl border border-neutral-200 bg-white p-2 dark:border-neutral-700 dark:bg-neutral-900"
          role="menu"
        >
          {
            redditLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                role="menuitem"
                class="rounded-lg px-3 py-2 text-sm font-medium text-neutral-700 no-underline transition hover:bg-neutral-100 hover:text-blue-700 focus-visible:ring-2 focus-visible:ring-orange-700 focus-visible:outline-none dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-blue-300 dark:focus-visible:ring-orange-300"
              >
                {link.name}
              </a>
            ))
          }
        </div>
      </section>

      {
        isDocsPage && (
          <section class="mt-5 border-t border-neutral-200 pt-4 dark:border-neutral-700">
            <h3 class="mb-2 px-3 text-xs font-semibold tracking-wide text-neutral-500 uppercase dark:text-neutral-400">
              Documentation
            </h3>
            <nav aria-label="Documentation navigation">
              <DocsSidebar
                items={docsSidebar}
                currentPath={currentPath}
                idPrefix="mobile-nav"
              />
            </nav>
          </section>
        )
      }
    </div>
  </div>
</div>

<script>
  const initializeMobileNavigation = () => {
    const layer = document.querySelector<HTMLElement>(
      "[data-mobile-nav-layer]",
    );
    const drawer = document.querySelector<HTMLElement>(
      "[data-mobile-nav-drawer]",
    );
    const openButton = document.querySelector<HTMLButtonElement>(
      "[data-mobile-nav-open]",
    );
    const closeButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-mobile-nav-close]"),
    );

    if (
      !layer ||
      !drawer ||
      !openButton ||
      closeButtons.length === 0 ||
      layer.dataset.ready
    ) {
      return;
    }
    layer.dataset.ready = "true";

    let previousFocus: HTMLElement | null = null;
    const desktopQuery = window.matchMedia("(min-width: 80rem)");

    const setOpen = (open: boolean, restoreFocus = true) => {
      layer.dataset.open = String(open);
      layer.setAttribute("aria-hidden", String(!open));
      drawer.setAttribute("aria-hidden", String(!open));
      drawer.toggleAttribute("inert", !open);
      openButton.setAttribute("aria-expanded", String(open));
      openButton.setAttribute(
        "aria-label",
        open ? "Close site navigation" : "Open site navigation",
      );
      openButton
        .querySelector("[data-mobile-nav-menu-icon]")
        ?.classList.toggle("hidden", open);
      openButton
        .querySelector("[data-mobile-nav-close-icon]")
        ?.classList.toggle("hidden", !open);
      document.body.classList.toggle("mobile-nav-open", open);

      if (open) {
        previousFocus =
          document.activeElement instanceof HTMLElement
            ? document.activeElement
            : openButton;
        drawer
          .querySelector<HTMLElement>("[data-mobile-nav-close-button]")
          ?.focus();
      } else if (restoreFocus) {
        previousFocus?.focus();
        previousFocus = null;
      }
    };

    openButton.addEventListener("click", () => setOpen(true));
    closeButtons.forEach((button) =>
      button.addEventListener("click", () => setOpen(false)),
    );
    drawer
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", () => setOpen(false)));

    document.addEventListener("keydown", (event) => {
      if (layer.dataset.open !== "true") return;
      if (event.key === "Escape") {
        setOpen(false);
        return;
      }
      if (event.key !== "Tab") return;

      const focusable = Array.from(
        drawer.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((element) => element.getClientRects().length > 0);
      const first = focusable[0];
      const last = focusable.at(-1);
      if (!first || !last) return;

      if (
        event.shiftKey &&
        (document.activeElement === first ||
          !drawer.contains(document.activeElement))
      ) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    desktopQuery.addEventListener("change", (event) => {
      if (event.matches && layer.dataset.open === "true") setOpen(false, false);
    });
  };

  const initializeSubtleScrollbars = () => {
    document
      .querySelectorAll<HTMLElement>("[data-subtle-scrollbar]")
      .forEach((element) => {
        if (element.dataset.scrollbarReady) return;
        element.dataset.scrollbarReady = "true";

        let hideTimer = 0;
        element.addEventListener(
          "scroll",
          () => {
            element.dataset.scrolling = "true";
            window.clearTimeout(hideTimer);
            hideTimer = window.setTimeout(() => {
              delete element.dataset.scrolling;
            }, 800);
          },
          { passive: true },
        );
      });
  };

  initializeMobileNavigation();
  initializeSubtleScrollbars();
  document.addEventListener("astro:page-load", initializeMobileNavigation);
  document.addEventListener("astro:page-load", initializeSubtleScrollbars);
</script>

<style>
  .mobile-nav-layer {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: none;
  }

  .mobile-nav-layer[data-open="true"] {
    display: block;
  }

  .mobile-nav-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    border: 0;
    background: rgb(0 0 0 / 0.62);
    opacity: 0;
    transition: opacity 220ms ease-out;
  }

  .mobile-nav-drawer {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    width: min(88vw, 25rem);
    height: 100%;
    overflow: hidden;
    transform: translateX(100%);
    transition: transform 250ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .mobile-nav-layer[data-open="true"] .mobile-nav-backdrop {
    opacity: 1;
  }

  .mobile-nav-layer[data-open="true"] .mobile-nav-drawer {
    transform: translateX(0);
  }

  :global(body.mobile-nav-open) {
    overflow: hidden;
  }

  @media (min-width: 80rem) {
    .mobile-nav-layer {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav-backdrop,
    .mobile-nav-drawer {
      transition: none;
    }
  }
</style>

---
import BrandLogoDark from "../../../assets/images/logo_dark.svg";
import CookiePreferencesButton from "@components/ui/buttons/CookiePreferencesButton.astro";
---

<footer
  class="w-full border-t border-[#343434] bg-[#1d1d1d] text-neutral-300"
  aria-label="Site footer"
>
  <div
    class="mx-auto flex min-h-16 w-full max-w-[85rem] flex-wrap items-center justify-between gap-x-8 gap-y-3 px-4 py-3 sm:px-6 lg:px-16 2xl:max-w-(--breakpoint-2xl)"
  >
    <a
      href="/"
      class="shrink-0 rounded-md outline-hidden transition-opacity hover:opacity-70 focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 focus-visible:ring-offset-[#1d1d1d]"
      aria-label="Microsoft Certification Hub home"
    >
      <img
        src={BrandLogoDark.src}
        alt="Microsoft Certification Hub"
        class="block h-auto w-28"
      />
    </a>

    <nav
      aria-label="Footer links"
      class="flex flex-wrap items-center gap-x-5 gap-y-2"
    >
      <a
        href="/privacy/"
        class="rounded-sm text-xs font-medium text-neutral-300 transition-colors hover:text-white focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:outline-none"
      >
        Privacy
      </a>
      <a
        href="/contact/"
        class="rounded-sm text-xs font-medium text-neutral-300 transition-colors hover:text-white focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:outline-none"
      >
        Contact
      </a>
      <a
        href="/contributing/"
        class="rounded-sm text-xs font-medium text-neutral-300 transition-colors hover:text-white focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:outline-none"
      >
        Contributing
      </a>
      <span class="hidden h-4 w-px bg-[#343434] sm:block" aria-hidden="true"
      ></span>
      <CookiePreferencesButton text="Cookies" variant="secondary" size="xs" />
    </nav>
  </div>
</footer>

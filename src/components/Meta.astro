---
import { getImage } from "astro:assets";
import { OG, SITE } from "@data/constants";
import faviconSvgSrc from "@images/favicon.svg";
import faviconSrc from "@images/favicon.svg";

const {
  title = SITE.title,
  meta = SITE.description,
  structuredData,
  noindex = false,
  customDescription = null,
  customOgTitle = null,
} = Astro.props;

const description = customDescription || meta;
const ogTitle = customOgTitle || title;
const ogDescription = customDescription || meta;

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, `${siteUrl}/`).href;
const defaultStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  inLanguage: "en-US",
  "@id": canonical,
  url: canonical,
  name: title,
  description,
  isPartOf: {
    "@type": "WebSite",
    url: `${siteUrl}/`,
    name: SITE.title,
    description: SITE.description,
  },
};
const pageStructuredData =
  structuredData === false ? null : (structuredData ?? defaultStructuredData);
const socialImageRes = await getImage({
  src: OG.image,
  width: 1200,
  height: 600,
  format: "png",
});
const socialImage = socialImageRes.src.startsWith("http")
  ? socialImageRes.src
  : new URL(socialImageRes.src, `${Astro.url.origin}/`).href;

const languages: { [key: string]: string } = {
  en: "",
};

function createHref(prefix: string, path: string): string {
  const cleanPath = path.replace(/^\/en\//, "/");

  const basePath = prefix ? `/${prefix}${cleanPath}` : cleanPath;
  const normalizedBasePath = basePath.replace(/\/\/+/g, "/");

  return `${siteUrl}${normalizedBasePath}`;
}

const fullPath: string = Astro.url.pathname;

const alternateLanguageLinks: string = Object.entries(languages)
  .map(([lang, prefix]: [string, string]) => {
    const cleanPath = fullPath.replace(/^\/en\//, "/");
    const href: string = createHref(prefix, cleanPath);

    return `<link rel="alternate" hreflang="${lang}" href="${href}" />`;
  })
  .join("\n");

// Generate and optimize the favicon images
const faviconSvg = await getImage({
  src: faviconSvgSrc,
  format: "svg",
});

const appleTouchIcon = await getImage({
  src: faviconSrc,
  width: 180,
  height: 180,
  format: "png",
});
---

{
  /*  Inject structured data into the page if provided. This data is formatted as JSON-LD, a method recommended by Google for structured data pass:
     https://developers.google.com/search/docs/advanced/structured-data/intro-structured-data */
}{
  pageStructuredData && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(pageStructuredData)}
      is:inline
    />
  )
}
{/* Define the character set, description, author, and viewport settings */}
<meta charset="utf-8" />
<meta content={description} name="description" />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0"
/>
<meta http-equiv="X-UA-Compatible" content="ie=edge" />
<link rel="canonical" href={canonical} />
<Fragment set:html={alternateLanguageLinks} />

{/* Facebook Meta Tags */}
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:title" content={ogTitle} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={socialImage} />
<meta content="1200" property="og:image:width" />
<meta content="600" property="og:image:height" />
<meta content="image/png" property="og:image:type" />

{/* Twitter Meta Tags */}
<meta name="twitter:card" content="summary_large_image" />
<meta property="twitter:domain" content="msfthub.com" />
<meta property="twitter:url" content={canonical} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={socialImage} />

{/* Links to the webmanifest and sitemap */}
<link rel="manifest" href="/manifest.json" />
{/* https://docs.astro.build/en/guides/integrations-guide/sitemap/ */}
<link rel="sitemap" href="/sitemap-index.xml" />

{/* Links for favicons */}
<link href="/favicon.ico" rel="icon" sizes="any" type="image/x-icon" />
<link href={faviconSvg.src} rel="icon" type="image/svg+xml" sizes="any" />
<meta name="mobile-web-app-capable" content="yes" />
<link href={appleTouchIcon.src} rel="apple-touch-icon" />
<link href={appleTouchIcon.src} rel="shortcut icon" />
{/* Set theme color */}
<meta name="theme-color" content="#60A5FA" />

---
import { Icon } from "astro-icon/components";
---

<button
  type="button"
  data-theme-cycle
  aria-label="Theme: Dark. Switch to Light theme"
  title="Theme: Dark. Switch to Light theme"
  class="flex size-9 items-center justify-center rounded-lg text-neutral-600 transition hover:bg-neutral-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 dark:text-neutral-300 dark:hover:bg-neutral-700"
>
  <span data-theme-icon="dark">
    <Icon name="ph:moon" class="size-5" aria-hidden="true" />
  </span>
  <span data-theme-icon="light" class="hidden">
    <Icon name="ph:sun" class="size-5" aria-hidden="true" />
  </span>
  <span data-theme-icon="auto" class="hidden">
    <Icon name="ph:monitor" class="size-5" aria-hidden="true" />
  </span>
</button>

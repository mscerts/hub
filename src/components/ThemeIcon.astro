<select
  aria-label="Color theme"
  data-theme-select
  class="h-9 w-24 rounded-lg border-0 bg-transparent py-1 pl-2 pr-7 text-sm text-neutral-600 focus-visible:ring-2 focus-visible:ring-blue-500 dark:text-neutral-300 dark:[color-scheme:dark]"
>
  <option value="light">Light</option>
  <option value="dark" selected>
    Dark
  </option>
  <option value="auto">System</option>
</select>

---
import { getCollection, render } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import GuidePage from "@components/docs/templates/GuidePage.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");

  return docs
    .filter((doc) => doc.id.startsWith("guide/") && doc.id !== "guide/introduction")
    .map((doc) => ({
      params: { slug: doc.id.replace("guide/", "") },
      props: { entry: doc },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<MainLayout
  title={`${entry.data.title} | Microsoft Certification Hub`}
  customDescription={entry.data.description ?? ""}
  wide
>
  <GuidePage
    title={entry.data.title}
    description={entry.data.description ?? ""}
    headings={headings}
  >
    <Content />
  </GuidePage>
</MainLayout>

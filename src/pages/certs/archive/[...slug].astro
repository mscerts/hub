---
import { getCollection, render } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import DocsPage from "@components/docs/templates/DocsPage.astro";
import { Aside } from "@components/docs";

export async function getStaticPaths() {
  return (await getCollection("archive", ({ data }) => !data.draft)).map(
    (entry) => ({
      params: { slug: entry.id.toLowerCase() },
      props: { entry },
    }),
  );
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<MainLayout
  title={`${entry.data.title} | Archive | Microsoft Certification Hub`}
  customDescription={entry.data.description ??
    "Archived certification resource."}
  noindex
  wide
>
  <DocsPage
    title={entry.data.title}
    description={entry.data.description ?? ""}
    headings={headings}
    sectionLabel="Archive"
  >
    <Aside type="caution" title="Archived content">
      This page is retained for historical reference and may contain outdated
      information. Visit <a href="/certs/">current certification resources</a> or
      return to the <a href="/certs/archive/">archive</a>.
    </Aside>
    <Content components={{ Aside }} />
  </DocsPage>
</MainLayout>

---
import { getCollection, render } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import DocsPage from "@components/docs/templates/DocsPage.astro";
import { Aside } from "@components/docs";

export async function getStaticPaths() {
  return (await getCollection("archive", ({ data }) => !data.draft)).map(
    (entry) => ({
      params: { slug: entry.id.toLowerCase() },
      props: { entry },
    }),
  );
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const archiveNotice = entry.id.startsWith("vouchers/")
  ? "expired-offer"
  : entry.id === "security/sc-730"
    ? "historical"
    : "retired-exam";
---

<MainLayout
  title={`${entry.data.title} | Archive | Microsoft Certification Hub`}
  customDescription={
    entry.data.description ?? "Archived certification resource."
  }
  noindex
  wide
>
  <DocsPage
    title={entry.data.title}
    description={entry.data.description ?? ""}
    headings={headings}
    sectionLabel="Archive"
    sourcePath={entry.filePath}
    archiveNotice={archiveNotice}
  >
    <Content components={{ Aside }} />
  </DocsPage>
</MainLayout>

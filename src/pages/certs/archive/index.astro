---
import { getCollection } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import DocsPage from "@components/docs/templates/DocsPage.astro";
import { CardGrid, LinkCard } from "@components/docs";
import { Icon } from "astro-icon/components";

const entries = (
  await getCollection("archive", ({ data }) => !data.draft)
).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, undefined, { numeric: true }),
);

const retiredExams = entries.filter(
  (entry) => !entry.id.startsWith("labs/") && !entry.id.startsWith("vouchers/"),
);
const archivedLabs = entries.filter((entry) => entry.id.startsWith("labs/"));
const expiredVouchers = entries.filter((entry) =>
  entry.id.startsWith("vouchers/"),
);

const sections = [
  {
    id: "retired-exams",
    title: "Retired Exams",
    items: retiredExams,
  },
  {
    id: "archived-labs",
    title: "Archived Hands-on Labs",
    items: archivedLabs,
  },
  {
    id: "archived-voucher-offers",
    title: "Expired Voucher Offers",
    items: expiredVouchers,
  },
].filter((section) => section.items.length > 0);

const headings = sections.map((section) => ({
  depth: 2,
  slug: section.id,
  text: section.title,
}));
---

<MainLayout
  title="Archive | Microsoft Certification Hub"
  customDescription="Previously published certification guides and resources retained for historical reference."
  wide
>
  <DocsPage
    title="Archive"
    description="Previously published guides and resources, retained for historical reference."
    headings={headings}
    sectionLabel="Archive"
    sourcePath="src/pages/certs/archive/index.astro"
  >
    {sections.length ? (
      sections.map((section) => (
        <section>
          <h2 id={section.id}>{section.title}</h2>
          <CardGrid>
            {section.items.map((entry) => (
              <LinkCard
                title={entry.data.title}
                description={entry.data.description}
                href={`/certs/archive/${entry.id.toLowerCase()}/`}
              />
            ))}
          </CardGrid>
        </section>
      ))
    ) : (
      <div class="border-border bg-card flex flex-col items-center gap-3 rounded-xl border px-6 py-10 text-center">
        <Icon
          name="ph:archive"
          class="text-muted-foreground size-8"
          aria-hidden="true"
        />
        <p class="text-foreground font-semibold">No archived pages yet.</p>
        <p class="text-muted-foreground max-w-md text-sm">
          Pages moved out of the active guides will appear here for historical
          reference.
        </p>
        <a href="/certs/">Browse current certification resources</a>
      </div>
    )}
  </DocsPage>
</MainLayout>

---
import { getCollection, render } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import DocsPage from "@components/docs/templates/DocsPage.astro";
import { Aside } from "@components/docs";
import { docsSectionLabel } from "@utils/docs";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  const isDev = import.meta.env.DEV;

  return docs
    .filter((entry) => entry.id !== "wiki" && (isDev || entry.data.draft !== true))
    .map((entry) => ({
      params: { slug: entry.id.toLowerCase() },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<MainLayout
  title={`${entry.data.title} | Microsoft Certification Hub`}
  customDescription={entry.data.description ?? ""}
  wide
>
  <DocsPage
    title={entry.data.title}
    description={entry.data.description ?? ""}
    headings={headings}
    sectionLabel={docsSectionLabel(entry.id)}
  >
    <Content components={{ Aside }} />
  </DocsPage>
</MainLayout>

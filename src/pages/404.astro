---
// Import section components
import MainLayout from "@/layouts/MainLayout.astro";
import Btn404 from "@components/ui/buttons/Btn404.astro";
import { SITE } from "@data/constants";

// Define variables for page content
const pageTitle = `Page Not Found | ${SITE.title}`;
const subTitle = "You've stumbled upon a broken link..";
const content =
  "This page has likely been retired or deleted. Please refer back to our site for the updated content.";
const btnTitle = "Go Back";
---

<MainLayout
  title={pageTitle}
  customDescription={content}
  customOgTitle={pageTitle}
  noindex
  structuredData={false}
>
  <section class="grid h-svh place-content-center">
    <div class="mx-auto max-w-(--breakpoint-xl) px-4 py-8 lg:px-6 lg:py-16">
      <div class="mx-auto max-w-(--breakpoint-sm) text-center">
        <h1 class="text-dark mb-4 text-7xl font-extrabold text-blue-700 lg:text-9xl dark:text-blue-300">
          404
        </h1>
        <p
          id="subtitle"
          class="mb-4 text-3xl font-bold tracking-tight text-balance text-neutral-700 md:text-4xl dark:text-neutral-300"
        >
          {subTitle}
        </p>
        <p
          id="content"
          class="mb-4 text-lg text-pretty text-neutral-600 dark:text-neutral-400"
        >
          {content}
        </p>
        <!-- Display recovery actions so visitors can find current resources -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <Btn404 title={btnTitle} id="go-back" />
          <a
            href="/certs/"
            class="inline-flex items-center justify-center rounded-lg border border-neutral-300 bg-white px-4 py-3 text-sm font-bold text-neutral-800 transition hover:bg-neutral-100 focus-visible:ring-3 focus-visible:ring-orange-400 focus-visible:outline-hidden dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-700"
          >
            Browse Exams
          </a>
          <a
            href="/certs/vouchers/"
            class="inline-flex items-center justify-center rounded-lg border border-neutral-300 bg-white px-4 py-3 text-sm font-bold text-neutral-800 transition hover:bg-neutral-100 focus-visible:ring-3 focus-visible:ring-orange-400 focus-visible:outline-hidden dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-700"
          >
            Exam Vouchers
          </a>
          <button
            type="button"
            data-search-trigger
            class="inline-flex items-center justify-center rounded-lg border border-neutral-300 bg-white px-4 py-3 text-sm font-bold text-neutral-800 transition hover:bg-neutral-100 focus-visible:ring-3 focus-visible:ring-orange-400 focus-visible:outline-hidden dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-700"
          >
            Search Hub
          </button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<!-- JavaScript code to handle going back to the previous page -->
<script>
  const goBackButton = document.getElementById("go-back") as HTMLButtonElement;

  goBackButton.addEventListener("click", () => {
    history.back();
  });
</script>

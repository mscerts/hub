---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE } from "@data/constants";

const pageTitle: string = `Privacy Policy | ${SITE.title}`;
const metaDescription =
  "Learn about how MSFTHub collects, uses, and protects your personal information.";
const ogTitle = "Privacy Policy | MSFTHub";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://msfthub.com/privacy/",
    url: "https://msfthub.com/privacy/",
    name: "Privacy Policy | MSFTHub",
    description: metaDescription,
    isPartOf: {
      "@type": "WebSite",
      url: "https://msfthub.com/",
      name: "MSFTHub",
      description: SITE.description,
    },
    inLanguage: "en-US",
  }}
>
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <!-- Title -->
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <h1 class="text-3xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
        Privacy Policy
      </h1>
      <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
        Last Updated: October 21, 2026
      </p>
    </div>

    <!-- Content -->
    <div class="mx-auto max-w-4xl">
      <div class="prose prose-neutral dark:prose-invert max-w-none">
        <!-- Introduction -->
        <div class="mb-8">
          <p class="text-lg text-neutral-700 dark:text-neutral-300">
            Microsoft Certification Hub ("MSFTHub", "we", "us", or "our") is an
            independent, community-driven website that provides information and
            resources related to Microsoft certifications. MSFTHub is not
            operated by or affiliated with Microsoft Corporation.
          </p>
          <p class="mt-4 text-lg text-neutral-700 dark:text-neutral-300">
            This Privacy Policy explains what information may be collected when
            you use MSFTHub, why it is collected, and the choices available to
            you.
          </p>
        </div>

        <!-- Information We Collect -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Information We Collect
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We aim to minimize the personal information we collect. Information
            may be collected in the following ways.
          </p>
        </div>

        <!-- Website and Technical Data -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Website and Technical Data
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            When you access MSFTHub, our hosting, content delivery, and security
            providers may process technical information necessary to deliver and
            protect the website. This may include information such as:
          </p>
          <ul class="mb-4 list-disc space-y-2 pl-6 text-neutral-700 dark:text-neutral-300">
            <li>IP address</li>
            <li>browser and device information</li>
            <li>requested pages and URLs</li>
            <li>timestamps</li>
            <li>network and security information</li>
          </ul>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            This information is primarily used to operate the website, detect
            abuse, troubleshoot technical problems, and maintain security.
          </p>
        </div>

        <!-- Analytics Data -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Analytics Data
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            With your consent where required, we use analytics services to
            understand how visitors interact with MSFTHub. Analytics information
            may include:
          </p>
          <ul class="mb-4 list-disc space-y-2 pl-6 text-neutral-700 dark:text-neutral-300">
            <li>pages viewed</li>
            <li>time spent on pages</li>
            <li>navigation and interaction patterns</li>
            <li>browser and device information</li>
            <li>approximate location derived from network information</li>
            <li>cookies or similar identifiers</li>
          </ul>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            You can manage non-essential analytics through the Cookie Settings
            control available on MSFTHub.
          </p>
        </div>

        <!-- Information You Provide -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Information You Provide
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            If you contact us, we may receive information you choose to provide,
            such as:
          </p>
          <ul class="mb-4 list-disc space-y-2 pl-6 text-neutral-700 dark:text-neutral-300">
            <li>your name</li>
            <li>email address</li>
            <li>the contents of your message</li>
            <li>attachments</li>
            <li>other information included in your request</li>
          </ul>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We use this information to respond to your message and provide
            support.
          </p>
        </div>

        <!-- Microsoft Clarity -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Microsoft Clarity
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We use Microsoft Clarity to better understand how visitors use
            MSFTHub. Clarity may provide behavioral analytics including page
            interactions, clicks, scrolling, heatmaps, diagnostic information,
            and session replay. Microsoft describes Clarity as collecting
            interaction and page-rendering information while providing controls
            for masking privacy-sensitive content.
          </p>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            Microsoft Clarity is a Microsoft service associated with Microsoft
            Advertising. MSFTHub does not use Microsoft Advertising to display
            advertisements on this website.
          </p>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We use Clarity for purposes such as:
          </p>
          <ul class="mb-4 list-disc space-y-2 pl-6 text-neutral-700 dark:text-neutral-300">
            <li>understanding how visitors navigate the site</li>
            <li>identifying confusing or broken experiences</li>
            <li>improving site design and usability</li>
            <li>diagnosing technical problems</li>
          </ul>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            Where supported, our consent configuration is intended to prevent
            advertising-related storage or sharing when advertising consent has
            not been granted. Microsoft documents separate analytics and
            advertising consent signals for Clarity.
          </p>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            For more information about Microsoft's handling of data, see the{" "}
            <a
              href="https://privacy.microsoft.com/privacystatement"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-orange-800 underline-offset-2 outline-none hover:underline focus-visible:underline dark:text-orange-300"
            >
              Microsoft Privacy Statement
            </a>
            .
          </p>
        </div>

        <!-- Google Analytics -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Google Analytics
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We use Google Analytics to understand website traffic and general
            usage patterns. Google Analytics may process information such as
            browser and device information, page visits, approximate geographic
            information, and cookies or similar identifiers.
          </p>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We use this information to understand how MSFTHub is used and
            improve our content and website experience. Google's own privacy
            policies govern its processing of information through Google
            Analytics.
          </p>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            For more information on the privacy practices of Google, please
            visit{" "}
            <a
              href="https://policies.google.com/privacy"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-orange-800 underline-offset-2 outline-none hover:underline focus-visible:underline dark:text-orange-300"
            >
              Google Privacy &amp; Terms
            </a>
            .
          </p>
        </div>

        <!-- Cookies -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Cookies
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            MSFTHub uses cookies and similar technologies for website
            functionality and, where you choose to allow them, analytics.
            Non-essential analytics cookies are controlled through our cookie
            preferences interface.
          </p>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            You may change your preferences using Cookie Settings on the
            website. Rejecting optional analytics cookies does not prevent you
            from accessing MSFTHub's core content.
          </p>
        </div>

        <!-- How We Use Information -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            How We Use Information
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            Information processed through MSFTHub may be used to:
          </p>
          <ul class="mb-4 list-disc space-y-2 pl-6 text-neutral-700 dark:text-neutral-300">
            <li>operate and maintain the website</li>
            <li>understand how visitors use MSFTHub</li>
            <li>improve content and navigation</li>
            <li>improve website performance and accessibility</li>
            <li>diagnose errors and technical problems</li>
            <li>detect and prevent abuse or security threats</li>
            <li>respond to messages and support requests</li>
          </ul>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We do not sell or rent personal information. We do not operate an
            advertising business or display behavioral advertising on MSFTHub.
          </p>
        </div>

        <!-- Service Providers and Subprocessors -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Service Providers and Subprocessors
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We use a limited number of third-party service providers to operate,
            secure, and understand the use of MSFTHub. These providers may
            process limited information on our behalf or in accordance with
            their own privacy terms.
          </p>
          <div class="mb-4 overflow-x-auto rounded-lg border border-neutral-300 dark:border-neutral-700">
            <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
              <thead class="bg-neutral-50 dark:bg-neutral-800">
                <tr>
                  <th class="border-b border-neutral-300 px-4 py-3 font-semibold text-neutral-800 dark:border-neutral-700 dark:text-neutral-200">
                    Provider
                  </th>
                  <th class="border-b border-neutral-300 px-4 py-3 font-semibold text-neutral-800 dark:border-neutral-700 dark:text-neutral-200">
                    Purpose
                  </th>
                  <th class="border-b border-neutral-300 px-4 py-3 font-semibold text-neutral-800 dark:border-neutral-700 dark:text-neutral-200">
                    Information that may be processed
                  </th>
                </tr>
              </thead>
              <tbody class="align-top text-neutral-700 dark:text-neutral-300 [&>tr:last-child>td]:border-b-0">
                <tr>
                  <th
                    scope="row"
                    class="border-b border-neutral-300 px-4 py-3 text-left font-semibold text-neutral-800 dark:border-neutral-700 dark:text-neutral-200"
                  >
                    Cloudflare
                  </th>
                  <td class="border-b border-neutral-300 px-4 py-3 dark:border-neutral-700">
                    Website hosting, content delivery, performance, DNS, and
                    security
                  </td>
                  <td class="border-b border-neutral-300 px-4 py-3 dark:border-neutral-700">
                    IP address, request metadata, browser/device information,
                    security and network information
                  </td>
                </tr>
                <tr>
                  <th
                    scope="row"
                    class="border-b border-neutral-300 px-4 py-3 text-left font-semibold text-neutral-800 dark:border-neutral-700 dark:text-neutral-200"
                  >
                    Google Analytics (GA4)
                  </th>
                  <td class="border-b border-neutral-300 px-4 py-3 dark:border-neutral-700">
                    Website analytics and usage measurement
                  </td>
                  <td class="border-b border-neutral-300 px-4 py-3 dark:border-neutral-700">
                    Page views, interaction data, browser/device information,
                    approximate location, cookies or similar identifiers
                  </td>
                </tr>
                <tr>
                  <th
                    scope="row"
                    class="border-b border-neutral-300 px-4 py-3 text-left font-semibold text-neutral-800 dark:border-neutral-700 dark:text-neutral-200"
                  >
                    Microsoft Clarity
                  </th>
                  <td class="border-b border-neutral-300 px-4 py-3 dark:border-neutral-700">
                    Website analytics, usability analysis, heatmaps, and session
                    replay
                  </td>
                  <td class="border-b border-neutral-300 px-4 py-3 dark:border-neutral-700">
                    Page interactions, clicks, scrolling, browser/device
                    information, diagnostic data, cookies or similar identifiers
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We only use these services for purposes related to operating,
            securing, analyzing, and improving MSFTHub.
          </p>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            MSFTHub does not use Microsoft Advertising to display
            advertisements, even though Microsoft Clarity is part of Microsoft's
            advertising and analytics services.
          </p>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            Where required, optional analytics services such as Google Analytics
            and Microsoft Clarity are subject to your cookie preferences.
          </p>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            These providers may process information in countries other than the
            country where you live. Their processing is also subject to their
            respective privacy policies and applicable data protection terms.
          </p>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We may update this list if the services used to operate MSFTHub
            change.
          </p>
        </div>

        <!-- Third-Party Links -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Third-Party Links
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            MSFTHub contains links to websites and services operated by other
            organizations. Once you leave MSFTHub, the privacy practices of the
            destination website apply. We are not responsible for the content or
            privacy practices of third-party websites.
          </p>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We recommend reviewing their privacy policies before providing
            personal information.
          </p>
        </div>

        <!-- Data Retention -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Data Retention
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We retain information only for as long as reasonably necessary for
            the purpose for which it was collected, including providing support,
            maintaining security, resolving technical issues, or complying with
            applicable legal requirements.
          </p>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            Third-party analytics and infrastructure providers may maintain
            their own retention periods under their respective policies.
          </p>
        </div>

        <!-- Your Privacy Choices -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Your Privacy Choices
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            Depending on where you live, you may have rights concerning personal
            information associated with you, including rights to:
          </p>
          <ul class="mb-4 list-disc space-y-2 pl-6 text-neutral-700 dark:text-neutral-300">
            <li>request access to personal information</li>
            <li>request correction of inaccurate information</li>
            <li>request deletion of information</li>
            <li>object to or restrict certain processing</li>
            <li>withdraw consent where processing is based on consent</li>
          </ul>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            You can also withdraw consent for optional analytics through our
            Cookie Settings. If you would like to make a privacy-related
            request, please contact us using the information below.
          </p>
        </div>

        <!-- Security -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Security
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We take reasonable technical and organizational measures intended to
            protect the systems used to operate MSFTHub. However, no website or
            Internet transmission can be guaranteed to be completely secure.
          </p>
        </div>

        <!-- Changes to This Privacy Policy -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Changes to This Privacy Policy
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            We may update this Privacy Policy when our website, services, or
            data practices change. When we make changes, we will update the Last
            Updated date at the top of this page. Material changes may also be
            communicated elsewhere on MSFTHub where appropriate.
          </p>
        </div>

        <!-- Contact Us -->
        <div class="mb-10">
          <h2 class="mb-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">
            Contact Us
          </h2>
          <p class="mb-4 text-neutral-700 dark:text-neutral-300">
            If you have questions, concerns, or requests relating to this
            Privacy Policy or how MSFTHub handles information, please use our{" "}
            <a
              href="/contact/"
              class="font-medium text-orange-800 underline-offset-2 outline-none hover:underline focus-visible:underline dark:text-orange-300"
            >
              Contact page
            </a>
            .
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
